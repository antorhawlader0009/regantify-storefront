/* ---------------------------------------------------------------------------------------------------------------------
   Furnilux: the FurniLux furniture template (templete/others-templetes/Furniture & Home/furnilux) on StorePal's features. The store
   layout (and lib/portalRoot.ts for dialogs) adds data-skin="furnilux" next to data-theme="storepal". White page, forest green
   (#3f6b1f, deeper #2f5016, pale #e9f0e1) as the accent and the fill of buttons, sale red (#e11d2e) for prices, warm cream
   (#f7f5f0) panels, Plus Jakarta Sans everywhere with extra-bold headings, rounded white cards with a thin stone line, a
   near-black (#171717) footer. Store > Branding's own colour and fonts still win. Shared StorePal parts that Solevo also draws read
   the sv-* classes and --sv-* variables, re-pointed to this look below.
   --------------------------------------------------------------------------------------------------------------------- */
[data-theme='storepal'][data-skin='furnilux'] {
  --color-ink: #171717;
  --color-canvas: #ffffff;
  --color-surface: #ffffff;
  --color-accent: #3f6b1f;
  --color-accent-dark: #2f5016;
  --color-accent-light: #f4f4f2;
  --color-muted: #525252;
  --color-line: #e7e5e4;
  --color-line-strong: rgba(23, 23, 23, 0.25);
  --color-success: #15803d;
  --color-success-bg: #e8f6ee;
  --color-save: #e11d2e;
  --fu-brand: #3f6b1f;
  --fu-brand-dark: #2f5016;
  --fu-latte: #e9f0e1;
  --fu-mocha: #3f6b1f;
  --fu-taupe: #3f6b1f;
  --fu-stone: #525252;
  --fu-soft: #f4f4f2;
  --fu-cream: #ffffff;
  --fu-sand: #f4f4f2;
  --fu-peach: #f4f4f2;
  --fu-card: #f4f4f2;
  --fu-panel: #f7f5f0;
  --fu-tan: #e9f0e1;
  --fu-blush: #f4f4f2;
  --fu-footer: #171717;
  /* Names the shared Solevo/PlayMate parts read (cards, stars, soft boxes, copper highlights). */
  --sv-gold: #3f6b1f;
  --sv-gold-dark: #2f5016;
  --sv-sand: #f4f4f2;
  --sv-card: #f4f4f2;
  --sv-panel: #f7f5f0;
  --pm-card: #f4f4f2;
  --pm-soft: #f4f4f2;
  --pm-yellow: #3f6b1f;
  --pm-yellow-strong: #2f5016;
  --font-display: var(--font-jakarta), var(--font-bangla-store, var(--font-bangla)), Georgia, serif;
  --font-sans: var(--font-jakarta), var(--font-bangla-store, var(--font-bangla)), ui-sans-serif, system-ui, sans-serif;
  --shadow-card: 0 1px 2px rgba(23, 23, 23, 0.05), 0 4px 14px rgba(23, 23, 23, 0.05);
  --shadow-card-hover: 0 10px 28px rgba(23, 23, 23, 0.12);
  --shadow-popover: 0 12px 32px rgba(0, 0, 0, 0.16);
  font-family: var(--font-sans);
  font-size: 14px;
}

/* The template's container (max-w-7xl, px-4 sm:px-6 lg:px-8). */
[data-skin='furnilux'] .fu-wrap {
  margin-left: auto;
  margin-right: auto;
  width: 100%;
  max-width: 1240px;
  padding-left: 1rem;
  padding-right: 1rem;
}
@media (min-width: 640px) {
  [data-skin='furnilux'] .fu-wrap {
    padding-left: 1.5rem;
    padding-right: 1.5rem;
  }
}
@media (min-width: 1024px) {
  [data-skin='furnilux'] .fu-wrap {
    padding-left: 1.5rem;
    padding-right: 1.5rem;
  }
}
/* The template's buttons: an ink filled one and a white outline one. */
[data-skin='furnilux'] .fu-btn-dark,
[data-skin='furnilux'] .fu-btn-outline,
[data-skin='furnilux'] .sv-btn-dark,
[data-skin='furnilux'] .sv-btn-outline {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  border-radius: 0.25rem;
  padding: 0.7rem 1.5rem;
  font-size: 14px;
  font-weight: 500;
  transition: background-color 0.15s, color 0.15s, border-color 0.15s;
}
[data-skin='furnilux'] .fu-btn-dark,
[data-skin='furnilux'] .sv-btn-dark {
  background: #3f6b1f;
  color: #fff;
  box-shadow: 0 6px 20px rgba(23, 23, 23, 0.1);
}
[data-skin='furnilux'] .fu-btn-dark:hover,
[data-skin='furnilux'] .sv-btn-dark:hover {
  background: #2f5016;
}
[data-skin='furnilux'] .fu-btn-outline,
[data-skin='furnilux'] .sv-btn-outline {
  border: 1px solid #3f6b1f;
  background: transparent;
  color: #2f5016;
}
[data-skin='furnilux'] .fu-btn-outline:hover,
[data-skin='furnilux'] .sv-btn-outline:hover {
  background: #f4f4f2;
}
[data-skin='furnilux'] .sv-btn-outline.\!border-ink {
  border-color: #3f6b1f !important;
}
[data-skin='furnilux'] .fu-no-scrollbar {
  scrollbar-width: none;
}
[data-skin='furnilux'] .fu-no-scrollbar::-webkit-scrollbar {
  display: none;
}
/* Hero picture fades into the gradient behind it (the template's hero-fade). */
[data-skin='furnilux'] .fu-hero-fade {
  -webkit-mask-image: linear-gradient(to bottom, #000 65%, transparent 100%);
  mask-image: linear-gradient(to bottom, #000 65%, transparent 100%);
}
@media (min-width: 768px) {
  [data-skin='furnilux'] .fu-hero-fade {
    -webkit-mask-image: linear-gradient(to right, transparent 0%, #000 40%);
    mask-image: linear-gradient(to right, transparent 0%, #000 40%);
  }
}
@keyframes fu-fade-up {
  from {
    opacity: 0;
    transform: translateY(12px);
  }
  to {
    opacity: 1;
    transform: none;
  }
}
@keyframes fu-fade-in {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}
.fu-fade-up {
  animation: fu-fade-up 0.5s ease both;
}
.fu-fade-in {
  animation: fu-fade-in 0.4s ease both;
}
@keyframes fu-marquee-right {
  from {
    transform: translateX(-50%);
  }
  to {
    transform: translateX(0);
  }
}
[data-skin='furnilux'] .fu-marquee-track {
  animation: fu-marquee-right 32s linear infinite;
  will-change: transform;
}
[data-skin='furnilux'] .fu-marquee:hover .fu-marquee-track,
[data-skin='furnilux'] .fu-marquee:focus-within .fu-marquee-track {
  animation-play-state: paused;
}
@media (prefers-reduced-motion: reduce) {
  [data-skin='furnilux'] .fu-marquee-track {
    animation: none;
    transform: none;
  }
  [data-skin='furnilux'] .fu-marquee {
    overflow-x: auto;
  }
  .fu-fade-up,
  .fu-fade-in {
    animation: none;
  }
}
/* Simple pages (SkinPage): the intro line under the title lines up with it on the left. */
[data-skin='furnilux'] .fu-page > p.text-center:first-child {
  margin-top: -1rem;
  text-align: left;
}
/* The account panel (shared with Solevo's markup): rounded inputs, the template's coral main button. */
[data-skin='furnilux'] .sv-auth input:not([type='checkbox']):not([type='radio']) {
  border-radius: 0.375rem;
}
[data-skin='furnilux'] .sv-auth input:focus {
  border-color: #3f6b1f;
  box-shadow: none;
}
[data-skin='furnilux'] .sv-auth button[type='submit'] {
  border-radius: 0.375rem;
  background: #3f6b1f;
  color: #fff;
  font-size: 14px;
  font-weight: 500;
}
[data-skin='furnilux'] .sv-auth button[type='submit']:hover {
  background: #2f5016;
}
/* The product panel's tabs and quantity box take the corner radius of the template's cards. */
[data-skin='furnilux'] [data-rg='product-tabs'] .border-accent {
  border-color: #3f6b1f;
}
[data-skin='furnilux'] [data-rg='product-tabs'] span.rounded-full.bg-accent {
  background-color: #3f6b1f;
}
/* Furnilux's checkout page: StorePal's form cards become the template's white rounded boxes with the soft shadow. */
[data-skin='furnilux'] .fu-checkout div.bg-surface.border-line.rounded-lg {
  background: #fff;
  border-color: rgba(63, 107, 31, 0.15);
  border-radius: 0.75rem;
  box-shadow: var(--shadow-card);
}
/* Furnilux's footer is deep brown (StorePal's is navy), so StorePal's navy footer rule is undone here for the parts
   Furnilux's footer reuses. */
[data-theme='storepal'][data-skin='furnilux'] footer[data-rg='footer'] {
  background-color: var(--fu-footer);
  color: rgba(255, 255, 255, 0.8);
  --color-ink: #ffffff;
  --color-muted: rgba(255, 255, 255, 0.7);
  --color-line: rgba(255, 255, 255, 0.1);
  --color-line-strong: rgba(255, 255, 255, 0.2);
  --color-surface: rgba(255, 255, 255, 0.06);
  --color-canvas: #171717;
  --color-accent: #e9f0e1;
  --color-accent-dark: #ffffff;
}

