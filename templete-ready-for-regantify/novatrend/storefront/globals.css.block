/* ---------------------------------------------------------------------------------------------------------------------
   Novatrend: the NovaTrend general-store template (templete/others-templetes/General/novatrend) on StorePal's features. The store
   layout (and lib/portalRoot.ts for dialogs) adds data-skin="novatrend" next to data-theme="storepal". White page and header,
   vivid orange (#d43d0a, deeper #d73904, pale #fff1eb) as the accent and the fill of buttons, near-black (#0b0b0b) announcement
   bar, hero and footer, light grey (#f6f6f6) rounded product cards, Inter everywhere with extra-bold headings. Store > Branding's
   own colour and fonts still win. Shared StorePal parts that Solevo also draws read the sv-* classes and --sv-* variables,
   re-pointed to this look below.
   --------------------------------------------------------------------------------------------------------------------- */
[data-theme='storepal'][data-skin='novatrend'] {
  --color-ink: #0b0b0b;
  --color-canvas: #ffffff;
  --color-surface: #ffffff;
  --color-accent: #d43d0a;
  --color-accent-dark: #d73904;
  --color-accent-light: #f6f6f6;
  --color-muted: #525252;
  --color-line: #e7e5e4;
  --color-line-strong: rgba(11, 11, 11, 0.25);
  --color-success: #15803d;
  --color-success-bg: #e8f6ee;
  --color-save: #d43d0a;
  --nt-brand: #d43d0a;
  --nt-brand-dark: #d73904;
  --nt-latte: #fff1eb;
  --nt-mocha: #d43d0a;
  --nt-taupe: #d43d0a;
  --nt-stone: #525252;
  --nt-soft: #f6f6f6;
  --nt-cream: #ffffff;
  --nt-sand: #f6f6f6;
  --nt-peach: #f6f6f6;
  --nt-card: #f6f6f6;
  --nt-panel: #f6f6f6;
  --nt-tan: #fff1eb;
  --nt-blush: #f6f6f6;
  --nt-footer: #0b0b0b;
  /* Names the shared Solevo/PlayMate parts read (cards, stars, soft boxes, copper highlights). */
  --sv-gold: #d43d0a;
  --sv-gold-dark: #d73904;
  --sv-sand: #f6f6f6;
  --sv-card: #f6f6f6;
  --sv-panel: #f6f6f6;
  --pm-card: #f6f6f6;
  --pm-soft: #f6f6f6;
  --pm-yellow: #d43d0a;
  --pm-yellow-strong: #d73904;
  --font-display: var(--font-inter), var(--font-bangla-store, var(--font-bangla)), Georgia, serif;
  --font-sans: var(--font-inter), var(--font-bangla-store, var(--font-bangla)), ui-sans-serif, system-ui, sans-serif;
  --shadow-card: 0 8px 30px rgba(0, 0, 0, 0.08);
  --shadow-card-hover: 0 8px 30px rgba(0, 0, 0, 0.12);
  --shadow-popover: 0 12px 32px rgba(0, 0, 0, 0.16);
  font-family: var(--font-sans);
  font-size: 14px;
}

/* The template's container (max-w-7xl, px-4 sm:px-6 lg:px-8). */
[data-skin='novatrend'] .nt-wrap {
  margin-left: auto;
  margin-right: auto;
  width: 100%;
  max-width: 1240px;
  padding-left: 1rem;
  padding-right: 1rem;
}
@media (min-width: 640px) {
  [data-skin='novatrend'] .nt-wrap {
    padding-left: 1.5rem;
    padding-right: 1.5rem;
  }
}
@media (min-width: 1024px) {
  [data-skin='novatrend'] .nt-wrap {
    padding-left: 2rem;
    padding-right: 2rem;
  }
}
/* The template's buttons: an ink filled one and a white outline one. */
[data-skin='novatrend'] .nt-btn-dark,
[data-skin='novatrend'] .nt-btn-outline,
[data-skin='novatrend'] .sv-btn-dark,
[data-skin='novatrend'] .sv-btn-outline {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  border-radius: 0.375rem;
  padding: 0.75rem 1.5rem;
  font-size: 14px;
  font-weight: 500;
  transition: background-color 0.15s, color 0.15s, border-color 0.15s;
}
[data-skin='novatrend'] .nt-btn-dark,
[data-skin='novatrend'] .sv-btn-dark {
  background: #d43d0a;
  color: #fff;
  box-shadow: 0 6px 20px rgba(11, 11, 11, 0.1);
}
[data-skin='novatrend'] .nt-btn-dark:hover,
[data-skin='novatrend'] .sv-btn-dark:hover {
  background: #d73904;
}
[data-skin='novatrend'] .nt-btn-outline,
[data-skin='novatrend'] .sv-btn-outline {
  border: 1px solid #d43d0a;
  background: transparent;
  color: #d73904;
}
[data-skin='novatrend'] .nt-btn-outline:hover,
[data-skin='novatrend'] .sv-btn-outline:hover {
  background: #f6f6f6;
}
[data-skin='novatrend'] .sv-btn-outline.\!border-ink {
  border-color: #d43d0a !important;
}
[data-skin='novatrend'] .nt-no-scrollbar {
  scrollbar-width: none;
}
[data-skin='novatrend'] .nt-no-scrollbar::-webkit-scrollbar {
  display: none;
}
/* Hero picture fades into the gradient behind it (the template's hero-fade). */
[data-skin='novatrend'] .nt-hero-fade {
  -webkit-mask-image: linear-gradient(to bottom, #000 65%, transparent 100%);
  mask-image: linear-gradient(to bottom, #000 65%, transparent 100%);
}
@media (min-width: 768px) {
  [data-skin='novatrend'] .nt-hero-fade {
    -webkit-mask-image: linear-gradient(to right, transparent 0%, #000 40%);
    mask-image: linear-gradient(to right, transparent 0%, #000 40%);
  }
}
@keyframes nt-fade-up {
  from {
    opacity: 0;
    transform: translateY(12px);
  }
  to {
    opacity: 1;
    transform: none;
  }
}
@keyframes nt-fade-in {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}
.nt-fade-up {
  animation: nt-fade-up 0.5s ease both;
}
.nt-fade-in {
  animation: nt-fade-in 0.4s ease both;
}
@keyframes nt-marquee-right {
  from {
    transform: translateX(-50%);
  }
  to {
    transform: translateX(0);
  }
}
[data-skin='novatrend'] .nt-marquee-track {
  animation: nt-marquee-right 32s linear infinite;
  will-change: transform;
}
[data-skin='novatrend'] .nt-marquee:hover .nt-marquee-track,
[data-skin='novatrend'] .nt-marquee:focus-within .nt-marquee-track {
  animation-play-state: paused;
}
@media (prefers-reduced-motion: reduce) {
  [data-skin='novatrend'] .nt-marquee-track {
    animation: none;
    transform: none;
  }
  [data-skin='novatrend'] .nt-marquee {
    overflow-x: auto;
  }
  .nt-fade-up,
  .nt-fade-in {
    animation: none;
  }
}
/* Simple pages (SkinPage): the intro line under the title lines up with it on the left. */
[data-skin='novatrend'] .nt-page > p.text-center:first-child {
  margin-top: -1rem;
  text-align: left;
}
/* The account panel (shared with Solevo's markup): rounded inputs, the template's coral main button. */
[data-skin='novatrend'] .sv-auth input:not([type='checkbox']):not([type='radio']) {
  border-radius: 0.375rem;
}
[data-skin='novatrend'] .sv-auth input:focus {
  border-color: #d43d0a;
  box-shadow: none;
}
[data-skin='novatrend'] .sv-auth button[type='submit'] {
  border-radius: 0.375rem;
  background: #d43d0a;
  color: #fff;
  font-size: 14px;
  font-weight: 500;
}
[data-skin='novatrend'] .sv-auth button[type='submit']:hover {
  background: #d73904;
}
/* The product panel's tabs and quantity box take the corner radius of the template's cards. */
[data-skin='novatrend'] [data-rg='product-tabs'] .border-accent {
  border-color: #d43d0a;
}
[data-skin='novatrend'] [data-rg='product-tabs'] span.rounded-full.bg-accent {
  background-color: #d43d0a;
}
/* Novatrend's checkout page: StorePal's form cards become the template's white rounded boxes with the soft shadow. */
[data-skin='novatrend'] .nt-checkout div.bg-surface.border-line.rounded-lg {
  background: #fff;
  border-color: rgba(255, 75, 15, 0.15);
  border-radius: 0.75rem;
  box-shadow: var(--shadow-card);
}
/* Novatrend's footer is deep brown (StorePal's is navy), so StorePal's navy footer rule is undone here for the parts
   Novatrend's footer reuses. */
[data-theme='storepal'][data-skin='novatrend'] footer[data-rg='footer'] {
  background-color: var(--nt-footer);
  color: rgba(255, 255, 255, 0.8);
  --color-ink: #ffffff;
  --color-muted: rgba(255, 255, 255, 0.7);
  --color-line: rgba(255, 255, 255, 0.1);
  --color-line-strong: rgba(255, 255, 255, 0.2);
  --color-surface: rgba(255, 255, 255, 0.06);
  --color-canvas: #0b0b0b;
  --color-accent: #d43d0a;
  --color-accent-dark: #ff7a4d;
}

