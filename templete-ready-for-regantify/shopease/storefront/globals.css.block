/* ---------------------------------------------------------------------------------------------------------------------
   Shopease: the ShopEase general-store template (templete/others-templetes/General/shopease) on StorePal's features. The store
   layout (and lib/portalRoot.ts for dialogs) adds data-skin="shopease" next to data-theme="storepal". White page and header,
   vivid orange (#ff5a0f, deeper #e04a05) as the accent and the fill of buttons, a deep forest green (#153a2b) announcement bar,
   peach (#fdf0e6) panels, warm sand (#f4efe8) light footer, white rounded cards with a soft shadow on a warm #f6f3ef photo
   area, Inter everywhere with extra-bold headings. Store > Branding's own colour and fonts still win. Shared StorePal parts
   that Solevo also draws read the sv-* classes and --sv-* variables, re-pointed to this look below.
   (The template's own tailwind config was missing from its folder, so forest, peach and sand are close guesses from the
   markup: forest as a dark green, peach and sand as warm light tones.)
   --------------------------------------------------------------------------------------------------------------------- */
[data-theme='storepal'][data-skin='shopease'] {
  --color-ink: #111111;
  --color-canvas: #ffffff;
  --color-surface: #ffffff;
  --color-accent: #ff5a0f;
  --color-accent-dark: #e04a05;
  --color-accent-light: #f6f3ef;
  --color-muted: #525252;
  --color-line: #ececec;
  --color-line-strong: rgba(0, 0, 0, 0.25);
  --color-success: #15803d;
  --color-success-bg: #e8f6ee;
  --color-save: #ff5a0f;
  --se-brand: #ff5a0f;
  --se-brand-dark: #e04a05;
  --se-latte: #e5e5e5;
  --se-mocha: #ff5a0f;
  --se-taupe: #ff5a0f;
  --se-stone: #525252;
  --se-soft: #fdf0e6;
  --se-cream: #ffffff;
  --se-sand: #f6f3ef;
  --se-peach: #f6f3ef;
  --se-card: #f6f3ef;
  --se-panel: #f6f3ef;
  --se-tan: #e5e5e5;
  --se-blush: #f6f3ef;
  --se-footer: #f4efe8;
  --se-ink: #111111;
  --se-deeper: #153a2b;
  --se-sage: #fdf0e6;
  /* Names the shared Solevo/PlayMate parts read (cards, stars, soft boxes, copper highlights). */
  --sv-gold: #ff5a0f;
  --sv-gold-dark: #e04a05;
  --sv-sand: #f6f3ef;
  --sv-card: #f6f3ef;
  --sv-panel: #f6f3ef;
  --pm-card: #f6f3ef;
  --pm-soft: #f6f3ef;
  --pm-yellow: #ff5a0f;
  --pm-yellow-strong: #e04a05;
  --font-display: var(--font-inter), var(--font-bangla-store, var(--font-bangla)), Georgia, serif;
  --font-sans: var(--font-inter), var(--font-bangla-store, var(--font-bangla)), ui-sans-serif, system-ui, sans-serif;
  --shadow-card: 0 1px 6px rgba(0, 0, 0, 0.06);
  --shadow-card-hover: 0 8px 24px rgba(0, 0, 0, 0.12);
  --shadow-popover: 0 12px 32px rgba(0, 0, 0, 0.16);
  font-family: var(--font-sans);
  font-size: 14px;
}

/* The template's container (max-w-7xl, px-4 sm:px-6 lg:px-8). */
[data-skin='shopease'] .se-wrap {
  margin-left: auto;
  margin-right: auto;
  width: 100%;
  max-width: 1200px;
  padding-left: 1.5rem;
  padding-right: 1.5rem;
}
@media (min-width: 640px) {
  [data-skin='shopease'] .se-wrap {
    padding-left: 1.5rem;
    padding-right: 1.5rem;
  }
}
@media (min-width: 1024px) {
  [data-skin='shopease'] .se-wrap {
    padding-left: 1.5rem;
    padding-right: 1.5rem;
  }
}
/* The template's buttons: a green filled one and a green outline one. */
[data-skin='shopease'] .se-btn-dark,
[data-skin='shopease'] .se-btn-outline,
[data-skin='shopease'] .sv-btn-dark,
[data-skin='shopease'] .sv-btn-outline {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  border-radius: 0.375rem;
  padding: 0.7rem 1.5rem;
  font-size: 14px;
  font-weight: 500;
  transition: background-color 0.15s, color 0.15s, border-color 0.15s;
}
[data-skin='shopease'] .se-btn-dark,
[data-skin='shopease'] .sv-btn-dark {
  background: #ff5a0f;
  color: #fff;
  box-shadow: 0 6px 20px rgba(0, 0, 0, 0.1);
}
[data-skin='shopease'] .se-btn-dark:hover,
[data-skin='shopease'] .sv-btn-dark:hover {
  background: #e04a05;
}
[data-skin='shopease'] .se-btn-outline,
[data-skin='shopease'] .sv-btn-outline {
  border: 1px solid #ff5a0f;
  background: transparent;
  color: #ff5a0f;
}
[data-skin='shopease'] .se-btn-outline:hover,
[data-skin='shopease'] .sv-btn-outline:hover {
  background: #f6f3ef;
}
[data-skin='shopease'] .sv-btn-outline.\!border-ink {
  border-color: #ff5a0f !important;
}
[data-skin='shopease'] .se-no-scrollbar {
  scrollbar-width: none;
}
[data-skin='shopease'] .se-no-scrollbar::-webkit-scrollbar {
  display: none;
}
/* Hero picture fades into the gradient behind it (the template's hero-fade). */
[data-skin='shopease'] .se-hero-fade {
  -webkit-mask-image: linear-gradient(to bottom, #000 65%, transparent 100%);
  mask-image: linear-gradient(to bottom, #000 65%, transparent 100%);
}
@media (min-width: 768px) {
  [data-skin='shopease'] .se-hero-fade {
    -webkit-mask-image: linear-gradient(to right, transparent 0%, #000 40%);
    mask-image: linear-gradient(to right, transparent 0%, #000 40%);
  }
}
@keyframes se-fade-up {
  from {
    opacity: 0;
    transform: translateY(12px);
  }
  to {
    opacity: 1;
    transform: none;
  }
}
@keyframes se-fade-in {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}
.se-fade-up {
  animation: se-fade-up 0.5s ease both;
}
.se-fade-in {
  animation: se-fade-in 0.4s ease both;
}
@keyframes se-marquee-right {
  from {
    transform: translateX(-50%);
  }
  to {
    transform: translateX(0);
  }
}
[data-skin='shopease'] .se-marquee-track {
  animation: se-marquee-right 32s linear infinite;
  will-change: transform;
}
[data-skin='shopease'] .se-marquee:hover .se-marquee-track,
[data-skin='shopease'] .se-marquee:focus-within .se-marquee-track {
  animation-play-state: paused;
}
@media (prefers-reduced-motion: reduce) {
  [data-skin='shopease'] .se-marquee-track {
    animation: none;
    transform: none;
  }
  [data-skin='shopease'] .se-marquee {
    overflow-x: auto;
  }
  .se-fade-up,
  .se-fade-in {
    animation: none;
  }
}
/* Simple pages (SkinPage): the intro line under the title lines up with it on the left. */
[data-skin='shopease'] .se-page > p.text-center:first-child {
  margin-top: -1rem;
  text-align: left;
}
/* The account panel (shared with Solevo's markup): rounded inputs, the template's coral main button. */
[data-skin='shopease'] .sv-auth input:not([type='checkbox']):not([type='radio']) {
  border-radius: 0.375rem;
}
[data-skin='shopease'] .sv-auth input:focus {
  border-color: #ff5a0f;
  box-shadow: none;
}
[data-skin='shopease'] .sv-auth button[type='submit'] {
  border-radius: 0.375rem;
  background: #ff5a0f;
  color: #fff;
  font-size: 14px;
  font-weight: 500;
}
[data-skin='shopease'] .sv-auth button[type='submit']:hover {
  background: #e04a05;
}
/* The product panel's tabs and quantity box take the corner radius of the template's cards. */
[data-skin='shopease'] [data-rg='product-tabs'] .border-accent {
  border-color: #ff5a0f;
}
[data-skin='shopease'] [data-rg='product-tabs'] span.rounded-full.bg-accent {
  background-color: #ff5a0f;
}
/* Shopease's checkout page: StorePal's form cards become the template's white rounded boxes with the soft shadow. */
[data-skin='shopease'] .se-checkout div.bg-surface.border-line.rounded-lg {
  background: #fff;
  border-color: rgba(255, 90, 15, 0.15);
  border-radius: 0.75rem;
  box-shadow: var(--shadow-card);
}
