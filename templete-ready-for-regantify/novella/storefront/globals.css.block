/* ---------------------------------------------------------------------------------------------------------------------
   Novella: the Novella marketplace template (templete/others-templetes/General/novella-store) on StorePal's features. The store
   layout (and lib/portalRoot.ts for dialogs) adds data-skin="novella" next to data-theme="storepal". Warm cream page and header
   (#faf8f5), terracotta (#c0714e, deeper #a85d3c) as the accent, sand (#f4efe9) panels, near-black (#111) buttons, hero and
   footer (#141414), white bordered product cards, Manrope everywhere with extra-bold headings. Store > Branding's own colour
   and fonts still win. Shared StorePal parts that Solevo also draws read the sv-* classes and --sv-* variables, re-pointed to
   this look below.
   --------------------------------------------------------------------------------------------------------------------- */
[data-theme='storepal'][data-skin='novella'] {
  --color-ink: #111111;
  --color-canvas: #faf8f5;
  --color-surface: #ffffff;
  --color-accent: #a85d3c;
  --color-accent-dark: #8f4d30;
  --color-accent-light: #f4efe9;
  --color-muted: #525252;
  --color-line: #e7e5e4;
  --color-line-strong: rgba(17, 17, 17, 0.25);
  --color-success: #15803d;
  --color-success-bg: #e8f6ee;
  --color-save: #a85d3c;
  --nv-brand: #a85d3c;
  --nv-brand-dark: #8f4d30;
  --nv-latte: #f4efe9;
  --nv-mocha: #a85d3c;
  --nv-taupe: #a85d3c;
  --nv-stone: #525252;
  --nv-soft: #f4efe9;
  --nv-cream: #faf8f5;
  --nv-sand: #f4efe9;
  --nv-peach: #f4efe9;
  --nv-card: #ffffff;
  --nv-panel: #f4efe9;
  --nv-tan: #f4efe9;
  --nv-blush: #f4efe9;
  --nv-footer: #141414;
  /* Names the shared Solevo/PlayMate parts read (cards, stars, soft boxes, copper highlights). */
  --sv-gold: #a85d3c;
  --sv-gold-dark: #8f4d30;
  --sv-sand: #f4efe9;
  --sv-card: #f4efe9;
  --sv-panel: #f4efe9;
  --pm-card: #f4efe9;
  --pm-soft: #f4efe9;
  --pm-yellow: #a85d3c;
  --pm-yellow-strong: #8f4d30;
  --font-display: var(--font-manrope), var(--font-bangla-store, var(--font-bangla)), Georgia, serif;
  --font-sans: var(--font-manrope), var(--font-bangla-store, var(--font-bangla)), ui-sans-serif, system-ui, sans-serif;
  --shadow-card: 0 10px 30px rgba(17, 17, 17, 0.08);
  --shadow-card-hover: 0 12px 32px rgba(17, 17, 17, 0.12);
  --shadow-popover: 0 12px 32px rgba(0, 0, 0, 0.16);
  font-family: var(--font-sans);
  font-size: 14px;
}

/* The template's container (max-w-7xl, px-4 sm:px-6 lg:px-8). */
[data-skin='novella'] .nv-wrap {
  margin-left: auto;
  margin-right: auto;
  width: 100%;
  max-width: 1240px;
  padding-left: 1rem;
  padding-right: 1rem;
}
@media (min-width: 640px) {
  [data-skin='novella'] .nv-wrap {
    padding-left: 1.5rem;
    padding-right: 1.5rem;
  }
}
@media (min-width: 1024px) {
  [data-skin='novella'] .nv-wrap {
    padding-left: 2rem;
    padding-right: 2rem;
  }
}
/* The template's buttons: an ink filled one and a white outline one. */
[data-skin='novella'] .nv-btn-dark,
[data-skin='novella'] .nv-btn-outline,
[data-skin='novella'] .sv-btn-dark,
[data-skin='novella'] .sv-btn-outline {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  border-radius: 0.375rem;
  padding: 0.75rem 1.5rem;
  font-size: 14px;
  font-weight: 500;
  transition: background-color 0.15s, color 0.15s, border-color 0.15s;
}
[data-skin='novella'] .nv-btn-dark,
[data-skin='novella'] .sv-btn-dark {
  background: #a85d3c;
  color: #fff;
  box-shadow: 0 6px 20px rgba(17, 17, 17, 0.1);
}
[data-skin='novella'] .nv-btn-dark:hover,
[data-skin='novella'] .sv-btn-dark:hover {
  background: #8f4d30;
}
[data-skin='novella'] .nv-btn-outline,
[data-skin='novella'] .sv-btn-outline {
  border: 1px solid #c0714e;
  background: transparent;
  color: #a85d3c;
}
[data-skin='novella'] .nv-btn-outline:hover,
[data-skin='novella'] .sv-btn-outline:hover {
  background: #f4efe9;
}
[data-skin='novella'] .sv-btn-outline.\!border-ink {
  border-color: #c0714e !important;
}
[data-skin='novella'] .nv-no-scrollbar {
  scrollbar-width: none;
}
[data-skin='novella'] .nv-no-scrollbar::-webkit-scrollbar {
  display: none;
}
/* Hero picture fades into the gradient behind it (the template's hero-fade). */
[data-skin='novella'] .nv-hero-fade {
  -webkit-mask-image: linear-gradient(to bottom, #000 65%, transparent 100%);
  mask-image: linear-gradient(to bottom, #000 65%, transparent 100%);
}
@media (min-width: 768px) {
  [data-skin='novella'] .nv-hero-fade {
    -webkit-mask-image: linear-gradient(to right, transparent 0%, #000 40%);
    mask-image: linear-gradient(to right, transparent 0%, #000 40%);
  }
}
@keyframes nv-fade-up {
  from {
    opacity: 0;
    transform: translateY(12px);
  }
  to {
    opacity: 1;
    transform: none;
  }
}
@keyframes nv-fade-in {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}
.nv-fade-up {
  animation: nv-fade-up 0.5s ease both;
}
.nv-fade-in {
  animation: nv-fade-in 0.4s ease both;
}
@keyframes nv-marquee-right {
  from {
    transform: translateX(-50%);
  }
  to {
    transform: translateX(0);
  }
}
[data-skin='novella'] .nv-marquee-track {
  animation: nv-marquee-right 32s linear infinite;
  will-change: transform;
}
[data-skin='novella'] .nv-marquee:hover .nv-marquee-track,
[data-skin='novella'] .nv-marquee:focus-within .nv-marquee-track {
  animation-play-state: paused;
}
@media (prefers-reduced-motion: reduce) {
  [data-skin='novella'] .nv-marquee-track {
    animation: none;
    transform: none;
  }
  [data-skin='novella'] .nv-marquee {
    overflow-x: auto;
  }
  .nv-fade-up,
  .nv-fade-in {
    animation: none;
  }
}
/* Simple pages (SkinPage): the intro line under the title lines up with it on the left. */
[data-skin='novella'] .nv-page > p.text-center:first-child {
  margin-top: -1rem;
  text-align: left;
}
/* The account panel (shared with Solevo's markup): rounded inputs, the template's coral main button. */
[data-skin='novella'] .sv-auth input:not([type='checkbox']):not([type='radio']) {
  border-radius: 0.375rem;
}
[data-skin='novella'] .sv-auth input:focus {
  border-color: #c0714e;
  box-shadow: none;
}
[data-skin='novella'] .sv-auth button[type='submit'] {
  border-radius: 0.375rem;
  background: #a85d3c;
  color: #fff;
  font-size: 14px;
  font-weight: 500;
}
[data-skin='novella'] .sv-auth button[type='submit']:hover {
  background: #8f4d30;
}
/* The product panel's tabs and quantity box take the corner radius of the template's cards. */
[data-skin='novella'] [data-rg='product-tabs'] .border-accent {
  border-color: #c0714e;
}
[data-skin='novella'] [data-rg='product-tabs'] span.rounded-full.bg-accent {
  background-color: #c0714e;
}
/* Novella's checkout page: StorePal's form cards become the template's white rounded boxes with the soft shadow. */
[data-skin='novella'] .nv-checkout div.bg-surface.border-line.rounded-lg {
  background: #fff;
  border-color: rgba(192, 113, 78, 0.15);
  border-radius: 0.75rem;
  box-shadow: var(--shadow-card);
}
/* Novella's footer is deep brown (StorePal's is navy), so StorePal's navy footer rule is undone here for the parts
   Novella's footer reuses. */
[data-theme='storepal'][data-skin='novella'] footer[data-rg='footer'] {
  background-color: var(--nv-footer);
  color: rgba(255, 255, 255, 0.8);
  --color-ink: #ffffff;
  --color-muted: rgba(255, 255, 255, 0.7);
  --color-line: rgba(255, 255, 255, 0.1);
  --color-line-strong: rgba(255, 255, 255, 0.2);
  --color-surface: rgba(255, 255, 255, 0.06);
  --color-canvas: #141414;
  --color-accent: #c0714e;
  --color-accent-dark: #dba083;
}

