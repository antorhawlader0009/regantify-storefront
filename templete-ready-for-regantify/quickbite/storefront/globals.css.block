/* ---------------------------------------------------------------------------------------------------------------------
   Quickbite: the QuickBite food-delivery template (templete/others-templetes/Grocery and Food/Food/quickbite) on StorePal's
   features. The store layout (and lib/portalRoot.ts for dialogs) adds data-skin="quickbite" next to data-theme="storepal". A warm
   peach-to-amber gradient behind everything, frosted-glass panels (white at 40% with a thin white line and a warm shadow),
   amber (#E9A23B, deeper #a16817, pale #FCEFD2) pill buttons with white text, brown ink (#2B2118), a dark brown footer (#2A211A),
   Playfair Display bold headings over Inter. Store > Branding's own colour and fonts still win. Shared StorePal parts that Solevo
   also draws read the sv-* classes and --sv-* variables, re-pointed to this look below.
   --------------------------------------------------------------------------------------------------------------------- */
[data-theme='storepal'][data-skin='quickbite'] {
  background: linear-gradient(135deg, #FFEBCB 0%, #FCD9A3 38%, #F9C98C 65%, #FFEFD6 100%);
  background-attachment: fixed;
  --color-ink: #2B2118;
  --color-canvas: #FFEFD6;
  --color-surface: #FFF9EE;
  --color-accent: #E9A23B;
  --color-accent-dark: #a16817;
  --color-accent-light: #FBF5E8;
  --color-muted: #525252;
  --color-line: rgba(43, 33, 24, 0.12);
  --color-line-strong: rgba(43, 33, 24, 0.25);
  --color-success: #15803d;
  --color-success-bg: #e8f6ee;
  --color-save: #E9A23B;
  --qb-brand: #E9A23B;
  --qb-brand-dark: #a16817;
  --qb-latte: #FCEFD2;
  --qb-mocha: #E9A23B;
  --qb-taupe: #E9A23B;
  --qb-stone: #525252;
  --qb-soft: #FCEFD2;
  --qb-cream: #FBF5E8;
  --qb-sand: #FBF5E8;
  --qb-peach: #FBF5E8;
  --qb-card: rgba(255, 255, 255, 0.4);
  --qb-panel: #FBF5E8;
  --qb-tan: #FCEFD2;
  --qb-blush: #FBF5E8;
  --qb-footer: #2A211A;
  /* Names the shared Solevo/PlayMate parts read (cards, stars, soft boxes, copper highlights). */
  --sv-gold: #E9A23B;
  --sv-gold-dark: #a16817;
  --sv-sand: #FBF5E8;
  --sv-card: #FBF5E8;
  --sv-panel: #FBF5E8;
  --pm-card: #FBF5E8;
  --pm-soft: #FBF5E8;
  --pm-yellow: #E9A23B;
  --pm-yellow-strong: #a16817;
  --font-display: var(--font-playfair), var(--font-bangla-store, var(--font-bangla)), Georgia, serif;
  --font-sans: var(--font-inter), var(--font-bangla-store, var(--font-bangla)), ui-sans-serif, system-ui, sans-serif;
  --shadow-card: 0 8px 32px rgba(120, 70, 10, 0.12);
  --shadow-card-hover: 0 14px 40px rgba(120, 70, 10, 0.2);
  --shadow-popover: 0 12px 32px rgba(0, 0, 0, 0.16);
  font-family: var(--font-sans);
  font-size: 14px;
}

/* The template's container (max-w-7xl, px-4 sm:px-6 lg:px-8). */
[data-skin='quickbite'] .qb-wrap {
  margin-left: auto;
  margin-right: auto;
  width: 100%;
  max-width: 1240px;
  padding-left: 1rem;
  padding-right: 1rem;
}
@media (min-width: 640px) {
  [data-skin='quickbite'] .qb-wrap {
    padding-left: 1.5rem;
    padding-right: 1.5rem;
  }
}
@media (min-width: 1024px) {
  [data-skin='quickbite'] .qb-wrap {
    padding-left: 2rem;
    padding-right: 2rem;
  }
}
/* The template's buttons: an ink filled one and a white outline one. */
[data-skin='quickbite'] .qb-btn-dark,
[data-skin='quickbite'] .qb-btn-outline,
[data-skin='quickbite'] .sv-btn-dark,
[data-skin='quickbite'] .sv-btn-outline {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  border-radius: 9999px;
  padding: 0.75rem 1.5rem;
  font-size: 14px;
  font-weight: 500;
  transition: background-color 0.15s, color 0.15s, border-color 0.15s;
}
[data-skin='quickbite'] .qb-btn-dark,
[data-skin='quickbite'] .sv-btn-dark {
  background: #E9A23B;
  color: #2A211A;
  box-shadow: 0 6px 20px rgba(43, 33, 24, 0.1);
}
[data-skin='quickbite'] .qb-btn-dark:hover,
[data-skin='quickbite'] .sv-btn-dark:hover {
  background: #a16817;
}
[data-skin='quickbite'] .qb-btn-outline,
[data-skin='quickbite'] .sv-btn-outline {
  border: 1px solid #E9A23B;
  background: transparent;
  color: #a16817;
}
[data-skin='quickbite'] .qb-btn-outline:hover,
[data-skin='quickbite'] .sv-btn-outline:hover {
  background: #FBF5E8;
}
[data-skin='quickbite'] .sv-btn-outline.\!border-ink {
  border-color: #E9A23B !important;
}
[data-skin='quickbite'] .qb-no-scrollbar {
  scrollbar-width: none;
}
[data-skin='quickbite'] .qb-no-scrollbar::-webkit-scrollbar {
  display: none;
}
/* Hero picture fades into the gradient behind it (the template's hero-fade). */
[data-skin='quickbite'] .qb-hero-fade {
  -webkit-mask-image: linear-gradient(to bottom, #000 65%, transparent 100%);
  mask-image: linear-gradient(to bottom, #000 65%, transparent 100%);
}
@media (min-width: 768px) {
  [data-skin='quickbite'] .qb-hero-fade {
    -webkit-mask-image: linear-gradient(to right, transparent 0%, #000 40%);
    mask-image: linear-gradient(to right, transparent 0%, #000 40%);
  }
}
@keyframes qb-fade-up {
  from {
    opacity: 0;
    transform: translateY(12px);
  }
  to {
    opacity: 1;
    transform: none;
  }
}
@keyframes qb-fade-in {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}
.qb-fade-up {
  animation: qb-fade-up 0.5s ease both;
}
.qb-fade-in {
  animation: qb-fade-in 0.4s ease both;
}
@keyframes qb-marquee-right {
  from {
    transform: translateX(-50%);
  }
  to {
    transform: translateX(0);
  }
}
[data-skin='quickbite'] .qb-marquee-track {
  animation: qb-marquee-right 32s linear infinite;
  will-change: transform;
}
[data-skin='quickbite'] .qb-marquee:hover .qb-marquee-track,
[data-skin='quickbite'] .qb-marquee:focus-within .qb-marquee-track {
  animation-play-state: paused;
}
@media (prefers-reduced-motion: reduce) {
  [data-skin='quickbite'] .qb-marquee-track {
    animation: none;
    transform: none;
  }
  [data-skin='quickbite'] .qb-marquee {
    overflow-x: auto;
  }
  .qb-fade-up,
  .qb-fade-in {
    animation: none;
  }
}
/* Simple pages (SkinPage): the intro line under the title lines up with it on the left. */
[data-skin='quickbite'] .qb-page > p.text-center:first-child {
  margin-top: -1rem;
  text-align: left;
}
/* The account panel (shared with Solevo's markup): rounded inputs, the template's coral main button. */
[data-skin='quickbite'] .sv-auth input:not([type='checkbox']):not([type='radio']) {
  border-radius: 0.375rem;
}
[data-skin='quickbite'] .sv-auth input:focus {
  border-color: #E9A23B;
  box-shadow: none;
}
[data-skin='quickbite'] .sv-auth button[type='submit'] {
  border-radius: 0.375rem;
  background: #E9A23B;
  color: #2A211A;
  font-size: 14px;
  font-weight: 500;
}
[data-skin='quickbite'] .sv-auth button[type='submit']:hover {
  background: #a16817;
}
/* The product panel's tabs and quantity box take the corner radius of the template's cards. */
[data-skin='quickbite'] [data-rg='product-tabs'] .border-accent {
  border-color: #E9A23B;
}
[data-skin='quickbite'] [data-rg='product-tabs'] span.rounded-full.bg-accent {
  background-color: #E9A23B;
}
/* Quickbite's checkout page: StorePal's form cards become the template's white rounded boxes with the soft shadow. */
[data-skin='quickbite'] .qb-checkout div.bg-surface.border-line.rounded-lg {
  background: #fff;
  border-color: rgba(233, 162, 59, 0.15);
  border-radius: 0.75rem;
  box-shadow: var(--shadow-card);
}
/* Quickbite's footer is deep brown (StorePal's is navy), so StorePal's navy footer rule is undone here for the parts
   Quickbite's footer reuses. */
[data-theme='storepal'][data-skin='quickbite'] footer[data-rg='footer'] {
  background-color: var(--qb-footer);
  color: rgba(255, 255, 255, 0.8);
  --color-ink: #ffffff;
  --color-muted: rgba(255, 255, 255, 0.7);
  --color-line: rgba(255, 255, 255, 0.1);
  --color-line-strong: rgba(255, 255, 255, 0.2);
  --color-surface: rgba(255, 255, 255, 0.06);
  --color-canvas: #2A211A;
  --color-accent: #E9A23B;
  --color-accent-dark: #F4C06A;
}


/* Frosted glass: the template's .glass / .glass-soft / .glass-dark. Never put backdrop-filter on the header (fixed children measure against it). */
[data-skin='quickbite'] .qb-glass {
  border: 1px solid rgba(255, 255, 255, 0.6);
  background: rgba(255, 255, 255, 0.4);
  box-shadow: 0 8px 32px rgba(120, 70, 10, 0.12);
  -webkit-backdrop-filter: blur(24px);
  backdrop-filter: blur(24px);
}
[data-skin='quickbite'] .qb-glass-soft {
  border: 1px solid rgba(255, 255, 255, 0.5);
  background: rgba(255, 255, 255, 0.25);
  -webkit-backdrop-filter: blur(16px);
  backdrop-filter: blur(16px);
}
