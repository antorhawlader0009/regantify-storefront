/* ---------------------------------------------------------------------------------------------------------------------
   Elevate (2026-11-09): the Elevate women's-fashion template (templete/others-templetes/Fashion/Clothing/elevate) on
   StorePal's features. The store layout (and lib/portalRoot.ts for dialogs) adds data-skin="elevate" next to
   data-theme="storepal". Coral (#1c1b19) is the shared accent, the page is warm cream, headings are Playfair Display.
   Store > Branding's own colour and fonts still win (inline on the same wrapper).
   Shared StorePal parts that Solevo also draws (product panel, account panel, product sections) read the sv-* classes and
   --sv-* variables, so those are re-pointed to Elevate's look below instead of copying the markup.
   --------------------------------------------------------------------------------------------------------------------- */
[data-theme='storepal'][data-skin='elevate'] {
  --color-ink: #1c1b19;
  --color-canvas: #ffffff;
  --color-surface: #ffffff;
  --color-accent: #1c1b19;
  --color-accent-dark: #000000;
  --color-accent-light: #efece7;
  --color-muted: #6b6b6b;
  --color-line: rgba(28, 27, 25, 0.12);
  --color-line-strong: rgba(27, 27, 27, 0.2);
  --color-success: #15803d;
  --color-success-bg: #e8f6ee;
  --color-save: #1c1b19;
  --el-brand: #1c1b19;
  --el-brand-dark: #000000;
  --el-soft: #efece7;
  --el-cream: #f6f3ee;
  --el-sand: #f6f3ee;
  --el-peach: #efece7;
  --el-card: #efece7;
  --el-panel: #f6f3ee;
  --el-tan: #e6e1d8;
  --el-blush: #efece7;
  --el-footer: #141413;
  /* Names the shared Solevo/PlayMate parts read (cards, stars, soft boxes, copper highlights). */
  --sv-gold: #1c1b19;
  --sv-gold-dark: #000000;
  --sv-sand: #f6f3ee;
  --sv-card: #efece7;
  --sv-panel: #f6f3ee;
  --pm-card: #efece7;
  --pm-soft: #efece7;
  --pm-yellow: #1c1b19;
  --pm-yellow-strong: #000000;
  --font-display: var(--font-cormorant), var(--font-bangla-store, var(--font-bangla)), Georgia, serif;
  --font-sans: var(--font-inter), var(--font-bangla-store, var(--font-bangla)), ui-sans-serif, system-ui, sans-serif;
  --shadow-card: none;
  --shadow-card-hover: none;
  --shadow-popover: 0 12px 32px rgba(0, 0, 0, 0.16);
  font-family: var(--font-sans);
}

/* The template's container (max-w-7xl, px-4 sm:px-6 lg:px-8). */
[data-skin='elevate'] .el-wrap {
  margin-left: auto;
  margin-right: auto;
  width: 100%;
  max-width: 80rem;
  padding-left: 1rem;
  padding-right: 1rem;
}
@media (min-width: 640px) {
  [data-skin='elevate'] .el-wrap {
    padding-left: 1.5rem;
    padding-right: 1.5rem;
  }
}
@media (min-width: 1024px) {
  [data-skin='elevate'] .el-wrap {
    padding-left: 2rem;
    padding-right: 2rem;
  }
}
/* The template's buttons: an ink filled one and an outline one that fills softly. */
[data-skin='elevate'] .el-btn-dark,
[data-skin='elevate'] .el-btn-outline,
[data-skin='elevate'] .sv-btn-dark,
[data-skin='elevate'] .sv-btn-outline {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  border-radius: 0;
  padding: 0.75rem 1.5rem;
  font-size: 11px;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  font-weight: 500;
  transition: background-color 0.15s, color 0.15s, border-color 0.15s;
}
[data-skin='elevate'] .el-btn-dark,
[data-skin='elevate'] .sv-btn-dark {
  background: #1c1b19;
  color: #fff;
  box-shadow: none;
}
[data-skin='elevate'] .el-btn-dark:hover,
[data-skin='elevate'] .sv-btn-dark:hover {
  background: #000000;
}
[data-skin='elevate'] .el-btn-outline,
[data-skin='elevate'] .sv-btn-outline {
  border: 1px solid #1c1b19;
  background: transparent;
  color: #1c1b19;
}
[data-skin='elevate'] .el-btn-outline:hover,
[data-skin='elevate'] .sv-btn-outline:hover {
  background: #efece7;
}
[data-skin='elevate'] .sv-btn-outline.\!border-ink {
  border-color: #1c1b19 !important;
}
[data-skin='elevate'] .el-no-scrollbar {
  scrollbar-width: none;
}
[data-skin='elevate'] .el-no-scrollbar::-webkit-scrollbar {
  display: none;
}
/* Hero picture fades into the gradient behind it (the template's hero-fade). */
[data-skin='elevate'] .el-hero-fade {
  -webkit-mask-image: linear-gradient(to bottom, #000 65%, transparent 100%);
  mask-image: linear-gradient(to bottom, #000 65%, transparent 100%);
}
@media (min-width: 768px) {
  [data-skin='elevate'] .el-hero-fade {
    -webkit-mask-image: linear-gradient(to right, transparent 0%, #000 40%);
    mask-image: linear-gradient(to right, transparent 0%, #000 40%);
  }
}
@keyframes el-fade-up {
  from {
    opacity: 0;
    transform: translateY(12px);
  }
  to {
    opacity: 1;
    transform: none;
  }
}
@keyframes el-fade-in {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}
.el-fade-up {
  animation: el-fade-up 0.5s ease both;
}
.el-fade-in {
  animation: el-fade-in 0.4s ease both;
}
@keyframes el-marquee-right {
  from {
    transform: translateX(-50%);
  }
  to {
    transform: translateX(0);
  }
}
[data-skin='elevate'] .el-marquee-track {
  animation: el-marquee-right 32s linear infinite;
  will-change: transform;
}
[data-skin='elevate'] .el-marquee:hover .el-marquee-track,
[data-skin='elevate'] .el-marquee:focus-within .el-marquee-track {
  animation-play-state: paused;
}
@media (prefers-reduced-motion: reduce) {
  [data-skin='elevate'] .el-marquee-track {
    animation: none;
    transform: none;
  }
  [data-skin='elevate'] .el-marquee {
    overflow-x: auto;
  }
  .el-fade-up,
  .el-fade-in {
    animation: none;
  }
}
/* Simple pages (SkinPage): the intro line under the title lines up with it on the left. */
[data-skin='elevate'] .el-page > p.text-center:first-child {
  margin-top: -1rem;
  text-align: left;
}
/* The account panel (shared with Solevo's markup): rounded inputs, the template's coral main button. */
[data-skin='elevate'] .sv-auth input:not([type='checkbox']):not([type='radio']) {
  border-radius: 0;
}
[data-skin='elevate'] .sv-auth input:focus {
  border-color: #1c1b19;
  box-shadow: none;
}
[data-skin='elevate'] .sv-auth button[type='submit'] {
  border-radius: 0;
  background: #1c1b19;
  color: #fff;
  font-size: 11px;
  font-weight: 500;
}
[data-skin='elevate'] .sv-auth button[type='submit']:hover {
  background: #000000;
}
/* The product panel's tabs and quantity box take the corner radius of the template's cards. */
[data-skin='elevate'] [data-rg='product-tabs'] .border-accent {
  border-color: #1c1b19;
}
[data-skin='elevate'] [data-rg='product-tabs'] span.rounded-full.bg-accent {
  background-color: #1c1b19;
}
/* Elevate's checkout page: StorePal's form cards become the template's white square boxes with the hairline border. */
[data-skin='elevate'] .el-checkout div.bg-surface.border-line.rounded-lg {
  background: #fff;
  border-color: rgba(28, 27, 25, 0.12);
  border-radius: 0;
  box-shadow: var(--shadow-card);
}
/* Elevate's footer is deep brown (StorePal's is navy), so StorePal's navy footer rule is undone here for the parts
   Elevate's footer reuses. */
[data-theme='storepal'][data-skin='elevate'] footer[data-rg='footer'] {
  background-color: var(--el-footer);
  color: rgba(255, 255, 255, 0.8);
  --color-ink: #ffffff;
  --color-muted: rgba(255, 255, 255, 0.7);
  --color-line: rgba(255, 255, 255, 0.1);
  --color-line-strong: rgba(255, 255, 255, 0.2);
  --color-surface: rgba(255, 255, 255, 0.06);
  --color-canvas: #141413;
  --color-accent: #ffffff;
  --color-accent-dark: #e6e1d8;
}

