/* ---------------------------------------------------------------------------------------------------------------------
   Petmart: the PetMart pet-store template (templete/others-templetes/Kids & Pets/petmart) on StorePal's features. The store layout
   (and lib/portalRoot.ts for dialogs) adds data-skin="petmart" next to data-theme="storepal". A white page, ember orange
   (#e8622a, deeper #cf5120) for the main buttons, the search button and tags, pine green (#1d4a3c, soft #e4efe9) for the top bar,
   the footer, the cart buttons and the features strip, a peach hero card (#fff3ea, #fdddc9), slate-grey thin lines, Poppins
   everywhere. Store > Branding's own colour and fonts still win. Shared StorePal parts that Solevo also draws read the sv-* classes
   and --sv-* variables, re-pointed to this look below.
   --------------------------------------------------------------------------------------------------------------------- */
[data-theme='storepal'][data-skin='petmart'] {
  --color-ink: #1c2b26;
  --color-canvas: #ffffff;
  --color-surface: #ffffff;
  --color-accent: #e8622a;
  --color-accent-dark: #cf5120;
  --color-accent-light: #e4efe9;
  --color-muted: #525252;
  --color-line: #f1f5f9;
  --color-line-strong: rgba(28, 43, 38, 0.25);
  --color-success: #15803d;
  --color-success-bg: #e8f6ee;
  --color-save: #e8622a;
  --pk-brand: #e8622a;
  --pk-brand-dark: #cf5120;
  --pk-latte: #e4efe9;
  --pk-mocha: #e8622a;
  --pk-taupe: #e8622a;
  --pk-stone: #525252;
  --pk-soft: #e4efe9;
  --pk-cream: #ffffff;
  --pk-sand: #e4efe9;
  --pk-peach: #e4efe9;
  --pk-card: #ffffff;
  --pk-panel: #e4efe9;
  --pk-tan: #e4efe9;
  --pk-blush: #e4efe9;
  --pk-footer: #1d4a3c;
  /* Names the shared Solevo/PlayMate parts read (cards, stars, soft boxes, copper highlights). */
  --sv-gold: #e8622a;
  --sv-gold-dark: #cf5120;
  --sv-sand: #e4efe9;
  --sv-card: #e4efe9;
  --sv-panel: #e4efe9;
  --pm-card: #e4efe9;
  --pm-soft: #e4efe9;
  --pm-yellow: #e8622a;
  --pm-yellow-strong: #cf5120;
  --font-display: var(--font-poppins), var(--font-bangla-store, var(--font-bangla)), Georgia, serif;
  --font-sans: var(--font-poppins), var(--font-bangla-store, var(--font-bangla)), ui-sans-serif, system-ui, sans-serif;
  --shadow-card: 0 1px 3px rgba(20, 40, 30, 0.08), 0 6px 18px rgba(20, 40, 30, 0.05);
  --shadow-card-hover: 0 6px 24px rgba(20, 40, 30, 0.14);
  --shadow-popover: 0 12px 32px rgba(0, 0, 0, 0.16);
  font-family: var(--font-sans);
  font-size: 14px;
}

/* The template's container (max-w-7xl, px-4 sm:px-6 lg:px-8). */
[data-skin='petmart'] .pk-wrap {
  margin-left: auto;
  margin-right: auto;
  width: 100%;
  max-width: 1240px;
  padding-left: 1rem;
  padding-right: 1rem;
}
@media (min-width: 640px) {
  [data-skin='petmart'] .pk-wrap {
    padding-left: 1.5rem;
    padding-right: 1.5rem;
  }
}
@media (min-width: 1024px) {
  [data-skin='petmart'] .pk-wrap {
    padding-left: 2rem;
    padding-right: 2rem;
  }
}
/* The template's buttons: an ink filled one and a white outline one. */
[data-skin='petmart'] .pk-btn-dark,
[data-skin='petmart'] .pk-btn-outline,
[data-skin='petmart'] .sv-btn-dark,
[data-skin='petmart'] .sv-btn-outline {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  border-radius: 0.375rem;
  padding: 0.75rem 1.5rem;
  font-size: 14px;
  font-weight: 500;
  transition: background-color 0.15s, color 0.15s, border-color 0.15s;
}
[data-skin='petmart'] .pk-btn-dark,
[data-skin='petmart'] .sv-btn-dark {
  background: #e8622a;
  color: #fff;
  box-shadow: 0 6px 20px rgba(28, 43, 38, 0.1);
}
[data-skin='petmart'] .pk-btn-dark:hover,
[data-skin='petmart'] .sv-btn-dark:hover {
  background: #cf5120;
}
[data-skin='petmart'] .pk-btn-outline,
[data-skin='petmart'] .sv-btn-outline {
  border: 1px solid #e8622a;
  background: transparent;
  color: #cf5120;
}
[data-skin='petmart'] .pk-btn-outline:hover,
[data-skin='petmart'] .sv-btn-outline:hover {
  background: #e4efe9;
}
[data-skin='petmart'] .sv-btn-outline.\!border-ink {
  border-color: #e8622a !important;
}
[data-skin='petmart'] .pk-no-scrollbar {
  scrollbar-width: none;
}
[data-skin='petmart'] .pk-no-scrollbar::-webkit-scrollbar {
  display: none;
}
/* Hero picture fades into the gradient behind it (the template's hero-fade). */
[data-skin='petmart'] .pk-hero-fade {
  -webkit-mask-image: linear-gradient(to bottom, #000 65%, transparent 100%);
  mask-image: linear-gradient(to bottom, #000 65%, transparent 100%);
}
@media (min-width: 768px) {
  [data-skin='petmart'] .pk-hero-fade {
    -webkit-mask-image: linear-gradient(to right, transparent 0%, #000 40%);
    mask-image: linear-gradient(to right, transparent 0%, #000 40%);
  }
}
@keyframes pk-fade-up {
  from {
    opacity: 0;
    transform: translateY(12px);
  }
  to {
    opacity: 1;
    transform: none;
  }
}
@keyframes pk-fade-in {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}
.pk-fade-up {
  animation: pk-fade-up 0.5s ease both;
}
.pk-fade-in {
  animation: pk-fade-in 0.4s ease both;
}
@keyframes pk-marquee-right {
  from {
    transform: translateX(-50%);
  }
  to {
    transform: translateX(0);
  }
}
[data-skin='petmart'] .pk-marquee-track {
  animation: pk-marquee-right 32s linear infinite;
  will-change: transform;
}
[data-skin='petmart'] .pk-marquee:hover .pk-marquee-track,
[data-skin='petmart'] .pk-marquee:focus-within .pk-marquee-track {
  animation-play-state: paused;
}
@media (prefers-reduced-motion: reduce) {
  [data-skin='petmart'] .pk-marquee-track {
    animation: none;
    transform: none;
  }
  [data-skin='petmart'] .pk-marquee {
    overflow-x: auto;
  }
  .pk-fade-up,
  .pk-fade-in {
    animation: none;
  }
}
/* Simple pages (SkinPage): the intro line under the title lines up with it on the left. */
[data-skin='petmart'] .pk-page > p.text-center:first-child {
  margin-top: -1rem;
  text-align: left;
}
/* The account panel (shared with Solevo's markup): rounded inputs, the template's coral main button. */
[data-skin='petmart'] .sv-auth input:not([type='checkbox']):not([type='radio']) {
  border-radius: 0.375rem;
}
[data-skin='petmart'] .sv-auth input:focus {
  border-color: #e8622a;
  box-shadow: none;
}
[data-skin='petmart'] .sv-auth button[type='submit'] {
  border-radius: 0.375rem;
  background: #e8622a;
  color: #fff;
  font-size: 14px;
  font-weight: 500;
}
[data-skin='petmart'] .sv-auth button[type='submit']:hover {
  background: #cf5120;
}
/* The product panel's tabs and quantity box take the corner radius of the template's cards. */
[data-skin='petmart'] [data-rg='product-tabs'] .border-accent {
  border-color: #e8622a;
}
[data-skin='petmart'] [data-rg='product-tabs'] span.rounded-full.bg-accent {
  background-color: #e8622a;
}
/* Petmart's checkout page: StorePal's form cards become the template's white rounded boxes with the soft shadow. */
[data-skin='petmart'] .pk-checkout div.bg-surface.border-line.rounded-lg {
  background: #fff;
  border-color: rgba(20, 40, 30, 0.15);
  border-radius: 0.75rem;
  box-shadow: var(--shadow-card);
}
/* Petmart's footer is deep brown (StorePal's is navy), so StorePal's navy footer rule is undone here for the parts
   Petmart's footer reuses. */
[data-theme='storepal'][data-skin='petmart'] footer[data-rg='footer'] {
  background-color: var(--pk-footer);
  color: rgba(255, 255, 255, 0.8);
  --color-ink: #ffffff;
  --color-muted: rgba(255, 255, 255, 0.7);
  --color-line: rgba(255, 255, 255, 0.1);
  --color-line-strong: rgba(255, 255, 255, 0.2);
  --color-surface: rgba(255, 255, 255, 0.06);
  --color-canvas: #1d4a3c;
  --color-accent: #e8622a;
  --color-accent-dark: #fdddc9;
}

