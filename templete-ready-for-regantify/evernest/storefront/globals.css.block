/* ---------------------------------------------------------------------------------------------------------------------
   Evernest: the Evernest Homes eco-living real-estate template (templete/others-templetes/Properties/evernest-homes) on StorePal's
   features. The store layout (and lib/portalRoot.ts for dialogs) adds data-skin="evernest" next to data-theme="storepal". A
   calm forest look: a cream page (#f7f7f0, darker #eef0e1), forest green (#46682d, hover #36501f, deepest #24361a) for pill
   buttons, links and the footer, soft lime (#a9d27d) highlights, white rounded cards with a soft green shadow, Playfair Display
   serif headings over Inter. Store > Branding's own colour and fonts still win. Shared StorePal parts that Solevo also draws
   read the sv-* classes and --sv-* variables, re-pointed to this look below.
   --------------------------------------------------------------------------------------------------------------------- */
[data-theme='storepal'][data-skin='evernest'] {
  --color-ink: #24361a;
  --color-canvas: #f7f7f0;
  --color-surface: #ffffff;
  --color-accent: #46682d;
  --color-accent-dark: #36501f;
  --color-accent-light: #f7f7f0;
  --color-muted: #525252;
  --color-line: #e7e5e4;
  --color-line-strong: rgba(36, 54, 26, 0.25);
  --color-success: #15803d;
  --color-success-bg: #e8f6ee;
  --color-save: #46682d;
  --ev-brand: #46682d;
  --ev-brand-dark: #36501f;
  --ev-latte: #e6ecda;
  --ev-mocha: #46682d;
  --ev-taupe: #46682d;
  --ev-stone: #525252;
  --ev-soft: #f7f7f0;
  --ev-cream: #ffffff;
  --ev-sand: #f7f7f0;
  --ev-peach: #f7f7f0;
  --ev-card: #f7f7f0;
  --ev-panel: #f7f7f0;
  --ev-tan: #e6ecda;
  --ev-blush: #f7f7f0;
  --ev-footer: #24361a;
  /* Names the shared Solevo/PlayMate parts read (cards, stars, soft boxes, copper highlights). */
  --sv-gold: #46682d;
  --sv-gold-dark: #36501f;
  --sv-sand: #f7f7f0;
  --sv-card: #f7f7f0;
  --sv-panel: #f7f7f0;
  --pm-card: #f7f7f0;
  --pm-soft: #f7f7f0;
  --pm-yellow: #46682d;
  --pm-yellow-strong: #36501f;
  --font-display: var(--font-playfair), var(--font-bangla-store, var(--font-bangla)), Georgia, serif;
  --font-sans: var(--font-inter), var(--font-bangla-store, var(--font-bangla)), ui-sans-serif, system-ui, sans-serif;
  --shadow-card: 0 10px 40px -12px rgba(36, 54, 26, 0.25);
  --shadow-card-hover: 0 14px 44px -12px rgba(36, 54, 26, 0.35);
  --shadow-popover: 0 12px 32px rgba(0, 0, 0, 0.16);
  font-family: var(--font-sans);
  font-size: 14px;
}

/* The template's container (max-w-7xl, px-4 sm:px-6 lg:px-8). */
[data-skin='evernest'] .ev-wrap {
  margin-left: auto;
  margin-right: auto;
  width: 100%;
  max-width: 1240px;
  padding-left: 1rem;
  padding-right: 1rem;
}
@media (min-width: 640px) {
  [data-skin='evernest'] .ev-wrap {
    padding-left: 1.5rem;
    padding-right: 1.5rem;
  }
}
@media (min-width: 1024px) {
  [data-skin='evernest'] .ev-wrap {
    padding-left: 2rem;
    padding-right: 2rem;
  }
}
/* The template's buttons: an ink filled one and a white outline one. */
[data-skin='evernest'] .ev-btn-dark,
[data-skin='evernest'] .ev-btn-outline,
[data-skin='evernest'] .sv-btn-dark,
[data-skin='evernest'] .sv-btn-outline {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  border-radius: 9999px;
  padding: 0.75rem 1.5rem;
  font-size: 14px;
  font-weight: 500;
  transition: background-color 0.15s, color 0.15s, border-color 0.15s;
}
[data-skin='evernest'] .ev-btn-dark,
[data-skin='evernest'] .sv-btn-dark {
  background: #46682d;
  color: #fff;
  box-shadow: 0 6px 20px rgba(36, 54, 26, 0.1);
}
[data-skin='evernest'] .ev-btn-dark:hover,
[data-skin='evernest'] .sv-btn-dark:hover {
  background: #36501f;
}
[data-skin='evernest'] .ev-btn-outline,
[data-skin='evernest'] .sv-btn-outline {
  border: 1px solid #46682d;
  background: transparent;
  color: #36501f;
}
[data-skin='evernest'] .ev-btn-outline:hover,
[data-skin='evernest'] .sv-btn-outline:hover {
  background: #f7f7f0;
}
[data-skin='evernest'] .sv-btn-outline.\!border-ink {
  border-color: #46682d !important;
}
[data-skin='evernest'] .ev-no-scrollbar {
  scrollbar-width: none;
}
[data-skin='evernest'] .ev-no-scrollbar::-webkit-scrollbar {
  display: none;
}
/* Hero picture fades into the gradient behind it (the template's hero-fade). */
[data-skin='evernest'] .ev-hero-fade {
  -webkit-mask-image: linear-gradient(to bottom, #000 65%, transparent 100%);
  mask-image: linear-gradient(to bottom, #000 65%, transparent 100%);
}
@media (min-width: 768px) {
  [data-skin='evernest'] .ev-hero-fade {
    -webkit-mask-image: linear-gradient(to right, transparent 0%, #000 40%);
    mask-image: linear-gradient(to right, transparent 0%, #000 40%);
  }
}
@keyframes ev-fade-up {
  from {
    opacity: 0;
    transform: translateY(12px);
  }
  to {
    opacity: 1;
    transform: none;
  }
}
@keyframes ev-fade-in {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}
.ev-fade-up {
  animation: ev-fade-up 0.5s ease both;
}
.ev-fade-in {
  animation: ev-fade-in 0.4s ease both;
}
@keyframes ev-marquee-right {
  from {
    transform: translateX(-50%);
  }
  to {
    transform: translateX(0);
  }
}
[data-skin='evernest'] .ev-marquee-track {
  animation: ev-marquee-right 32s linear infinite;
  will-change: transform;
}
[data-skin='evernest'] .ev-marquee:hover .ev-marquee-track,
[data-skin='evernest'] .ev-marquee:focus-within .ev-marquee-track {
  animation-play-state: paused;
}
@media (prefers-reduced-motion: reduce) {
  [data-skin='evernest'] .ev-marquee-track {
    animation: none;
    transform: none;
  }
  [data-skin='evernest'] .ev-marquee {
    overflow-x: auto;
  }
  .ev-fade-up,
  .ev-fade-in {
    animation: none;
  }
}
/* Simple pages (SkinPage): the intro line under the title lines up with it on the left. */
[data-skin='evernest'] .ev-page > p.text-center:first-child {
  margin-top: -1rem;
  text-align: left;
}
/* The account panel (shared with Solevo's markup): rounded inputs, the template's coral main button. */
[data-skin='evernest'] .sv-auth input:not([type='checkbox']):not([type='radio']) {
  border-radius: 0.375rem;
}
[data-skin='evernest'] .sv-auth input:focus {
  border-color: #46682d;
  box-shadow: none;
}
[data-skin='evernest'] .sv-auth button[type='submit'] {
  border-radius: 0.375rem;
  background: #46682d;
  color: #fff;
  font-size: 14px;
  font-weight: 500;
}
[data-skin='evernest'] .sv-auth button[type='submit']:hover {
  background: #36501f;
}
/* The product panel's tabs and quantity box take the corner radius of the template's cards. */
[data-skin='evernest'] [data-rg='product-tabs'] .border-accent {
  border-color: #46682d;
}
[data-skin='evernest'] [data-rg='product-tabs'] span.rounded-full.bg-accent {
  background-color: #46682d;
}
/* Evernest's checkout page: StorePal's form cards become the template's white rounded boxes with the soft shadow. */
[data-skin='evernest'] .ev-checkout div.bg-surface.border-line.rounded-lg {
  background: #fff;
  border-color: rgba(70, 104, 45, 0.15);
  border-radius: 0.75rem;
  box-shadow: var(--shadow-card);
}
/* Evernest's footer is deep brown (StorePal's is navy), so StorePal's navy footer rule is undone here for the parts
   Evernest's footer reuses. */
[data-theme='storepal'][data-skin='evernest'] footer[data-rg='footer'] {
  background-color: var(--ev-footer);
  color: rgba(255, 255, 255, 0.8);
  --color-ink: #ffffff;
  --color-muted: rgba(255, 255, 255, 0.7);
  --color-line: rgba(255, 255, 255, 0.1);
  --color-line-strong: rgba(255, 255, 255, 0.2);
  --color-surface: rgba(255, 255, 255, 0.06);
  --color-canvas: #24361a;
  --color-accent: #46682d;
  --color-accent-dark: #a9d27d;
}


