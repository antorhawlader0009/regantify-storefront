/* ---------------------------------------------------------------------------------------------------------------------
   Minimog: the Minimog lifestyle-store template (templete/others-templetes/General/minimog) on StorePal's features. The store layout
   (and lib/portalRoot.ts for dialogs) adds data-skin="minimog" next to data-theme="storepal". White page, forest green (#22632f,
   deeper #184a22 and #12301a for the top bar) as the accent and the fill of buttons, soft sage (#eef0e8) panels, near-black ink
   (#111), Inter everywhere with bold headings, compact text, a white header with underlined links, light neutral panels and a light
   footer. Store > Branding's own colour and fonts still win. Shared StorePal parts that Solevo also draws read the sv-* classes
   and --sv-* variables, re-pointed to this look below.
   --------------------------------------------------------------------------------------------------------------------- */
[data-theme='storepal'][data-skin='minimog'] {
  --color-ink: #111111;
  --color-canvas: #ffffff;
  --color-surface: #ffffff;
  --color-accent: #22632f;
  --color-accent-dark: #184a22;
  --color-accent-light: #f7f7f5;
  --color-muted: #525252;
  --color-line: #e5e5e5;
  --color-line-strong: rgba(0, 0, 0, 0.25);
  --color-success: #15803d;
  --color-success-bg: #e8f6ee;
  --color-save: #22632f;
  --mg-brand: #22632f;
  --mg-brand-dark: #184a22;
  --mg-latte: #e5e5e5;
  --mg-mocha: #22632f;
  --mg-taupe: #22632f;
  --mg-stone: #525252;
  --mg-soft: #eef0e8;
  --mg-cream: #ffffff;
  --mg-sand: #f7f7f5;
  --mg-peach: #f7f7f5;
  --mg-card: #f7f7f5;
  --mg-panel: #f7f7f5;
  --mg-tan: #e5e5e5;
  --mg-blush: #f7f7f5;
  --mg-footer: #fafafa;
  --mg-ink: #111111;
  --mg-deeper: #12301a;
  --mg-sage: #eef0e8;
  /* Names the shared Solevo/PlayMate parts read (cards, stars, soft boxes, copper highlights). */
  --sv-gold: #22632f;
  --sv-gold-dark: #184a22;
  --sv-sand: #f7f7f5;
  --sv-card: #f7f7f5;
  --sv-panel: #f7f7f5;
  --pm-card: #f7f7f5;
  --pm-soft: #f7f7f5;
  --pm-yellow: #22632f;
  --pm-yellow-strong: #184a22;
  --font-display: var(--font-inter), var(--font-bangla-store, var(--font-bangla)), Georgia, serif;
  --font-sans: var(--font-inter), var(--font-bangla-store, var(--font-bangla)), ui-sans-serif, system-ui, sans-serif;
  --shadow-card: 0 1px 6px rgba(0, 0, 0, 0.06);
  --shadow-card-hover: 0 8px 24px rgba(0, 0, 0, 0.12);
  --shadow-popover: 0 12px 32px rgba(0, 0, 0, 0.16);
  font-family: var(--font-sans);
  font-size: 14px;
}

/* The template's container (max-w-7xl, px-4 sm:px-6 lg:px-8). */
[data-skin='minimog'] .mg-wrap {
  margin-left: auto;
  margin-right: auto;
  width: 100%;
  max-width: 1200px;
  padding-left: 1.5rem;
  padding-right: 1.5rem;
}
@media (min-width: 640px) {
  [data-skin='minimog'] .mg-wrap {
    padding-left: 1.5rem;
    padding-right: 1.5rem;
  }
}
@media (min-width: 1024px) {
  [data-skin='minimog'] .mg-wrap {
    padding-left: 1.5rem;
    padding-right: 1.5rem;
  }
}
/* The template's buttons: a green filled one and a green outline one. */
[data-skin='minimog'] .mg-btn-dark,
[data-skin='minimog'] .mg-btn-outline,
[data-skin='minimog'] .sv-btn-dark,
[data-skin='minimog'] .sv-btn-outline {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  border-radius: 0.375rem;
  padding: 0.7rem 1.5rem;
  font-size: 14px;
  font-weight: 500;
  transition: background-color 0.15s, color 0.15s, border-color 0.15s;
}
[data-skin='minimog'] .mg-btn-dark,
[data-skin='minimog'] .sv-btn-dark {
  background: #22632f;
  color: #fff;
  box-shadow: 0 6px 20px rgba(0, 0, 0, 0.1);
}
[data-skin='minimog'] .mg-btn-dark:hover,
[data-skin='minimog'] .sv-btn-dark:hover {
  background: #184a22;
}
[data-skin='minimog'] .mg-btn-outline,
[data-skin='minimog'] .sv-btn-outline {
  border: 1px solid #22632f;
  background: transparent;
  color: #22632f;
}
[data-skin='minimog'] .mg-btn-outline:hover,
[data-skin='minimog'] .sv-btn-outline:hover {
  background: #f7f7f5;
}
[data-skin='minimog'] .sv-btn-outline.\!border-ink {
  border-color: #22632f !important;
}
[data-skin='minimog'] .mg-no-scrollbar {
  scrollbar-width: none;
}
[data-skin='minimog'] .mg-no-scrollbar::-webkit-scrollbar {
  display: none;
}
/* Hero picture fades into the gradient behind it (the template's hero-fade). */
[data-skin='minimog'] .mg-hero-fade {
  -webkit-mask-image: linear-gradient(to bottom, #000 65%, transparent 100%);
  mask-image: linear-gradient(to bottom, #000 65%, transparent 100%);
}
@media (min-width: 768px) {
  [data-skin='minimog'] .mg-hero-fade {
    -webkit-mask-image: linear-gradient(to right, transparent 0%, #000 40%);
    mask-image: linear-gradient(to right, transparent 0%, #000 40%);
  }
}
@keyframes mg-fade-up {
  from {
    opacity: 0;
    transform: translateY(12px);
  }
  to {
    opacity: 1;
    transform: none;
  }
}
@keyframes mg-fade-in {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}
.mg-fade-up {
  animation: mg-fade-up 0.5s ease both;
}
.mg-fade-in {
  animation: mg-fade-in 0.4s ease both;
}
@keyframes mg-marquee-right {
  from {
    transform: translateX(-50%);
  }
  to {
    transform: translateX(0);
  }
}
[data-skin='minimog'] .mg-marquee-track {
  animation: mg-marquee-right 32s linear infinite;
  will-change: transform;
}
[data-skin='minimog'] .mg-marquee:hover .mg-marquee-track,
[data-skin='minimog'] .mg-marquee:focus-within .mg-marquee-track {
  animation-play-state: paused;
}
@media (prefers-reduced-motion: reduce) {
  [data-skin='minimog'] .mg-marquee-track {
    animation: none;
    transform: none;
  }
  [data-skin='minimog'] .mg-marquee {
    overflow-x: auto;
  }
  .mg-fade-up,
  .mg-fade-in {
    animation: none;
  }
}
/* Simple pages (SkinPage): the intro line under the title lines up with it on the left. */
[data-skin='minimog'] .mg-page > p.text-center:first-child {
  margin-top: -1rem;
  text-align: left;
}
/* The account panel (shared with Solevo's markup): rounded inputs, the template's coral main button. */
[data-skin='minimog'] .sv-auth input:not([type='checkbox']):not([type='radio']) {
  border-radius: 0.375rem;
}
[data-skin='minimog'] .sv-auth input:focus {
  border-color: #22632f;
  box-shadow: none;
}
[data-skin='minimog'] .sv-auth button[type='submit'] {
  border-radius: 0.375rem;
  background: #22632f;
  color: #fff;
  font-size: 14px;
  font-weight: 500;
}
[data-skin='minimog'] .sv-auth button[type='submit']:hover {
  background: #184a22;
}
/* The product panel's tabs and quantity box take the corner radius of the template's cards. */
[data-skin='minimog'] [data-rg='product-tabs'] .border-accent {
  border-color: #22632f;
}
[data-skin='minimog'] [data-rg='product-tabs'] span.rounded-full.bg-accent {
  background-color: #22632f;
}
/* Minimog's checkout page: StorePal's form cards become the template's white rounded boxes with the soft shadow. */
[data-skin='minimog'] .mg-checkout div.bg-surface.border-line.rounded-lg {
  background: #fff;
  border-color: rgba(34, 99, 47, 0.15);
  border-radius: 0.75rem;
  box-shadow: var(--shadow-card);
}


/* Minimog's footer is light (#fafafa) with dark text: StorePal's base rule paints every footer navy with white text, so it is undone here. */
[data-theme='storepal'][data-skin='minimog'] footer[data-rg='footer'] {
  background-color: var(--mg-footer);
  border-top-color: #e5e5e5;
  color: #525252;
  --color-ink: #111111;
  --color-muted: #6b7280;
  --color-line: #e5e5e5;
  --color-line-strong: #d4d4d4;
  --color-surface: #ffffff;
  --color-canvas: #fafafa;
}
[data-theme='storepal'][data-skin='minimog'] footer[data-rg='footer'] .text-accent {
  color: #22632f;
}
