/* ---------------------------------------------------------------------------------------------------------------------
   Belora: the Belora skincare template (templete/others-templetes/Beauty and Health/belora-skincare) on StorePal's features. The store
   layout (and lib/portalRoot.ts for dialogs) adds data-skin="belora" next to data-theme="storepal". White page, violet (#6b3fa0) as the
   accent and the fill of buttons, pale violet (#f5f0fa) and soft violet (#e8dcf4) for panels and lines, near-black ink (#1e1b26),
   Cormorant Garamond headings over Inter, a violet announcement bar, a lavender hero, round category icons, a white footer.
   Store > Branding's own colour and fonts still win. Shared StorePal parts that Solevo also draws read the sv-* classes and --sv-*
   variables, re-pointed to this look below.
   --------------------------------------------------------------------------------------------------------------------- */
[data-theme='storepal'][data-skin='belora'] {
  --color-ink: #1e1b26;
  --color-canvas: #ffffff;
  --color-surface: #ffffff;
  --color-accent: #6b3fa0;
  --color-accent-dark: #4f2a7d;
  --color-accent-light: #f5f0fa;
  --color-muted: #5b5668;
  --color-line: #e8dcf4;
  --color-line-strong: rgba(60, 30, 100, 0.25);
  --color-success: #15803d;
  --color-success-bg: #e8f6ee;
  --color-save: #6b3fa0;
  --be-brand: #6b3fa0;
  --be-brand-dark: #4f2a7d;
  --be-latte: #e8dcf4;
  --be-mocha: #6b3fa0;
  --be-taupe: #8a63bd;
  --be-stone: #5b5668;
  --be-soft: #f5f0fa;
  --be-cream: #ffffff;
  --be-sand: #f5f0fa;
  --be-peach: #f5f0fa;
  --be-card: #f5f0fa;
  --be-panel: #f5f0fa;
  --be-tan: #e8dcf4;
  --be-blush: #f5f0fa;
  --be-footer: #ffffff;
  --be-ink: #1e1b26;
  /* Names the shared Solevo/PlayMate parts read (cards, stars, soft boxes, copper highlights). */
  --sv-gold: #6b3fa0;
  --sv-gold-dark: #4f2a7d;
  --sv-sand: #f5f0fa;
  --sv-card: #f5f0fa;
  --sv-panel: #f5f0fa;
  --pm-card: #f5f0fa;
  --pm-soft: #f5f0fa;
  --pm-yellow: #6b3fa0;
  --pm-yellow-strong: #4f2a7d;
  --font-display: var(--font-cormorant), var(--font-bangla-store, var(--font-bangla)), Georgia, serif;
  --font-sans: var(--font-inter), var(--font-bangla-store, var(--font-bangla)), ui-sans-serif, system-ui, sans-serif;
  --shadow-card: 0 2px 14px rgba(60, 30, 100, 0.08);
  --shadow-card-hover: 0 8px 24px rgba(60, 30, 100, 0.14);
  --shadow-popover: 0 12px 32px rgba(0, 0, 0, 0.16);
  font-family: var(--font-sans);
}

/* The template's container (max-w-7xl, px-4 sm:px-6 lg:px-8). */
[data-skin='belora'] .be-wrap {
  margin-left: auto;
  margin-right: auto;
  width: 100%;
  max-width: 1240px;
  padding-left: 1.5rem;
  padding-right: 1.5rem;
}
@media (min-width: 640px) {
  [data-skin='belora'] .be-wrap {
    padding-left: 1.5rem;
    padding-right: 1.5rem;
  }
}
@media (min-width: 1024px) {
  [data-skin='belora'] .be-wrap {
    padding-left: 1.5rem;
    padding-right: 1.5rem;
  }
}
/* The template's buttons: a violet filled one and a violet outline one. */
[data-skin='belora'] .be-btn-dark,
[data-skin='belora'] .be-btn-outline,
[data-skin='belora'] .sv-btn-dark,
[data-skin='belora'] .sv-btn-outline {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  border-radius: 0.375rem;
  padding: 0.75rem 1.5rem;
  font-size: 14px;
  font-weight: 500;
  transition: background-color 0.15s, color 0.15s, border-color 0.15s;
}
[data-skin='belora'] .be-btn-dark,
[data-skin='belora'] .sv-btn-dark {
  background: #6b3fa0;
  color: #fff;
  box-shadow: 0 6px 20px rgba(60, 30, 100, 0.1);
}
[data-skin='belora'] .be-btn-dark:hover,
[data-skin='belora'] .sv-btn-dark:hover {
  background: #4f2a7d;
}
[data-skin='belora'] .be-btn-outline,
[data-skin='belora'] .sv-btn-outline {
  border: 1px solid #6b3fa0;
  background: transparent;
  color: #6b3fa0;
}
[data-skin='belora'] .be-btn-outline:hover,
[data-skin='belora'] .sv-btn-outline:hover {
  background: #f5f0fa;
}
[data-skin='belora'] .sv-btn-outline.\!border-ink {
  border-color: #6b3fa0 !important;
}
[data-skin='belora'] .be-no-scrollbar {
  scrollbar-width: none;
}
[data-skin='belora'] .be-no-scrollbar::-webkit-scrollbar {
  display: none;
}
/* Hero picture fades into the gradient behind it (the template's hero-fade). */
[data-skin='belora'] .be-hero-fade {
  -webkit-mask-image: linear-gradient(to bottom, #000 65%, transparent 100%);
  mask-image: linear-gradient(to bottom, #000 65%, transparent 100%);
}
@media (min-width: 768px) {
  [data-skin='belora'] .be-hero-fade {
    -webkit-mask-image: linear-gradient(to right, transparent 0%, #000 40%);
    mask-image: linear-gradient(to right, transparent 0%, #000 40%);
  }
}
@keyframes be-fade-up {
  from {
    opacity: 0;
    transform: translateY(12px);
  }
  to {
    opacity: 1;
    transform: none;
  }
}
@keyframes be-fade-in {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}
.be-fade-up {
  animation: be-fade-up 0.5s ease both;
}
.be-fade-in {
  animation: be-fade-in 0.4s ease both;
}
@keyframes be-marquee-right {
  from {
    transform: translateX(-50%);
  }
  to {
    transform: translateX(0);
  }
}
[data-skin='belora'] .be-marquee-track {
  animation: be-marquee-right 32s linear infinite;
  will-change: transform;
}
[data-skin='belora'] .be-marquee:hover .be-marquee-track,
[data-skin='belora'] .be-marquee:focus-within .be-marquee-track {
  animation-play-state: paused;
}
@media (prefers-reduced-motion: reduce) {
  [data-skin='belora'] .be-marquee-track {
    animation: none;
    transform: none;
  }
  [data-skin='belora'] .be-marquee {
    overflow-x: auto;
  }
  .be-fade-up,
  .be-fade-in {
    animation: none;
  }
}
/* Simple pages (SkinPage): the intro line under the title lines up with it on the left. */
[data-skin='belora'] .be-page > p.text-center:first-child {
  margin-top: -1rem;
  text-align: left;
}
/* The account panel (shared with Solevo's markup): rounded inputs, the template's coral main button. */
[data-skin='belora'] .sv-auth input:not([type='checkbox']):not([type='radio']) {
  border-radius: 0.375rem;
}
[data-skin='belora'] .sv-auth input:focus {
  border-color: #6b3fa0;
  box-shadow: none;
}
[data-skin='belora'] .sv-auth button[type='submit'] {
  border-radius: 0.375rem;
  background: #6b3fa0;
  color: #fff;
  font-size: 14px;
  font-weight: 500;
}
[data-skin='belora'] .sv-auth button[type='submit']:hover {
  background: #4f2a7d;
}
/* The product panel's tabs and quantity box take the corner radius of the template's cards. */
[data-skin='belora'] [data-rg='product-tabs'] .border-accent {
  border-color: #6b3fa0;
}
[data-skin='belora'] [data-rg='product-tabs'] span.rounded-full.bg-accent {
  background-color: #6b3fa0;
}
/* Belora's checkout page: StorePal's form cards become the template's white rounded boxes with the soft shadow. */
[data-skin='belora'] .be-checkout div.bg-surface.border-line.rounded-lg {
  background: #fff;
  border-color: rgba(107, 63, 160, 0.15);
  border-radius: 0.75rem;
  box-shadow: var(--shadow-card);
}
