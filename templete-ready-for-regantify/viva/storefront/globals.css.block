/* ---------------------------------------------------------------------------------------------------------------------
   Viva: the Viva "Live Better" template (templete/others-templetes/General/viva) on StorePal's features. The store layout (and
   lib/portalRoot.ts for dialogs) adds data-skin="viva" next to data-theme="storepal". Warm cream page (#faf8f4) with white
   rounded panels and a soft green shadow, a deep forest green (#0d3b2e, hover #124a39, footer #082a20) for buttons, the search
   button and the footer, sage (#d9e1b5, pale #eef2dc) soft areas, coral (#ef7b7b) discount tags, Fraunces serif headings over
   Inter. Store > Branding's own colour and fonts still win. Shared StorePal parts that Solevo also draws read the sv-* classes
   and --sv-* variables, re-pointed to this look below.
   --------------------------------------------------------------------------------------------------------------------- */
[data-theme='storepal'][data-skin='viva'] {
  --color-ink: #1c2a24;
  --color-canvas: #faf8f4;
  --color-surface: #ffffff;
  --color-accent: #0d3b2e;
  --color-accent-dark: #124a39;
  --color-accent-light: #eef2dc;
  --color-muted: #525252;
  --color-line: #e8e6df;
  --color-line-strong: rgba(28, 42, 36, 0.25);
  --color-success: #15803d;
  --color-success-bg: #e8f6ee;
  --color-save: #0d3b2e;
  --vv-brand: #0d3b2e;
  --vv-brand-dark: #124a39;
  --vv-latte: #eef2dc;
  --vv-mocha: #0d3b2e;
  --vv-taupe: #0d3b2e;
  --vv-stone: #525252;
  --vv-soft: #eef2dc;
  --vv-cream: #faf8f4;
  --vv-sand: #eef2dc;
  --vv-peach: #eef2dc;
  --vv-card: #ffffff;
  --vv-panel: #eef2dc;
  --vv-tan: #eef2dc;
  --vv-blush: #eef2dc;
  --vv-footer: #082a20;
  /* Names the shared Solevo/PlayMate parts read (cards, stars, soft boxes, copper highlights). */
  --sv-gold: #0d3b2e;
  --sv-gold-dark: #124a39;
  --sv-sand: #eef2dc;
  --sv-card: #eef2dc;
  --sv-panel: #eef2dc;
  --pm-card: #eef2dc;
  --pm-soft: #eef2dc;
  --pm-yellow: #0d3b2e;
  --pm-yellow-strong: #124a39;
  --font-display: var(--font-fraunces), var(--font-bangla-store, var(--font-bangla)), Georgia, serif;
  --font-sans: var(--font-inter), var(--font-bangla-store, var(--font-bangla)), ui-sans-serif, system-ui, sans-serif;
  --shadow-card: 0 2px 14px rgba(13, 59, 46, 0.07);
  --shadow-card-hover: 0 10px 30px rgba(13, 59, 46, 0.14);
  --shadow-popover: 0 12px 32px rgba(0, 0, 0, 0.16);
  font-family: var(--font-sans);
  font-size: 14px;
}

/* The template's container (max-w-7xl, px-4 sm:px-6 lg:px-8). */
[data-skin='viva'] .vv-wrap {
  margin-left: auto;
  margin-right: auto;
  width: 100%;
  max-width: 1240px;
  padding-left: 1rem;
  padding-right: 1rem;
}
@media (min-width: 640px) {
  [data-skin='viva'] .vv-wrap {
    padding-left: 1.5rem;
    padding-right: 1.5rem;
  }
}
@media (min-width: 1024px) {
  [data-skin='viva'] .vv-wrap {
    padding-left: 2rem;
    padding-right: 2rem;
  }
}
/* The template's buttons: an ink filled one and a white outline one. */
[data-skin='viva'] .vv-btn-dark,
[data-skin='viva'] .vv-btn-outline,
[data-skin='viva'] .sv-btn-dark,
[data-skin='viva'] .sv-btn-outline {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  border-radius: 0.375rem;
  padding: 0.75rem 1.5rem;
  font-size: 14px;
  font-weight: 500;
  transition: background-color 0.15s, color 0.15s, border-color 0.15s;
}
[data-skin='viva'] .vv-btn-dark,
[data-skin='viva'] .sv-btn-dark {
  background: #0d3b2e;
  color: #fff;
  box-shadow: 0 6px 20px rgba(28, 42, 36, 0.1);
}
[data-skin='viva'] .vv-btn-dark:hover,
[data-skin='viva'] .sv-btn-dark:hover {
  background: #124a39;
}
[data-skin='viva'] .vv-btn-outline,
[data-skin='viva'] .sv-btn-outline {
  border: 1px solid #0d3b2e;
  background: transparent;
  color: #124a39;
}
[data-skin='viva'] .vv-btn-outline:hover,
[data-skin='viva'] .sv-btn-outline:hover {
  background: #eef2dc;
}
[data-skin='viva'] .sv-btn-outline.\!border-ink {
  border-color: #0d3b2e !important;
}
[data-skin='viva'] .vv-no-scrollbar {
  scrollbar-width: none;
}
[data-skin='viva'] .vv-no-scrollbar::-webkit-scrollbar {
  display: none;
}
/* Hero picture fades into the gradient behind it (the template's hero-fade). */
[data-skin='viva'] .vv-hero-fade {
  -webkit-mask-image: linear-gradient(to bottom, #000 65%, transparent 100%);
  mask-image: linear-gradient(to bottom, #000 65%, transparent 100%);
}
@media (min-width: 768px) {
  [data-skin='viva'] .vv-hero-fade {
    -webkit-mask-image: linear-gradient(to right, transparent 0%, #000 40%);
    mask-image: linear-gradient(to right, transparent 0%, #000 40%);
  }
}
@keyframes vv-fade-up {
  from {
    opacity: 0;
    transform: translateY(12px);
  }
  to {
    opacity: 1;
    transform: none;
  }
}
@keyframes vv-fade-in {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}
.vv-fade-up {
  animation: vv-fade-up 0.5s ease both;
}
.vv-fade-in {
  animation: vv-fade-in 0.4s ease both;
}
@keyframes vv-marquee-right {
  from {
    transform: translateX(-50%);
  }
  to {
    transform: translateX(0);
  }
}
[data-skin='viva'] .vv-marquee-track {
  animation: vv-marquee-right 32s linear infinite;
  will-change: transform;
}
[data-skin='viva'] .vv-marquee:hover .vv-marquee-track,
[data-skin='viva'] .vv-marquee:focus-within .vv-marquee-track {
  animation-play-state: paused;
}
@media (prefers-reduced-motion: reduce) {
  [data-skin='viva'] .vv-marquee-track {
    animation: none;
    transform: none;
  }
  [data-skin='viva'] .vv-marquee {
    overflow-x: auto;
  }
  .vv-fade-up,
  .vv-fade-in {
    animation: none;
  }
}
/* Simple pages (SkinPage): the intro line under the title lines up with it on the left. */
[data-skin='viva'] .vv-page > p.text-center:first-child {
  margin-top: -1rem;
  text-align: left;
}
/* The account panel (shared with Solevo's markup): rounded inputs, the template's coral main button. */
[data-skin='viva'] .sv-auth input:not([type='checkbox']):not([type='radio']) {
  border-radius: 0.375rem;
}
[data-skin='viva'] .sv-auth input:focus {
  border-color: #0d3b2e;
  box-shadow: none;
}
[data-skin='viva'] .sv-auth button[type='submit'] {
  border-radius: 0.375rem;
  background: #0d3b2e;
  color: #fff;
  font-size: 14px;
  font-weight: 500;
}
[data-skin='viva'] .sv-auth button[type='submit']:hover {
  background: #124a39;
}
/* The product panel's tabs and quantity box take the corner radius of the template's cards. */
[data-skin='viva'] [data-rg='product-tabs'] .border-accent {
  border-color: #0d3b2e;
}
[data-skin='viva'] [data-rg='product-tabs'] span.rounded-full.bg-accent {
  background-color: #0d3b2e;
}
/* Viva's checkout page: StorePal's form cards become the template's white rounded boxes with the soft shadow. */
[data-skin='viva'] .vv-checkout div.bg-surface.border-line.rounded-lg {
  background: #fff;
  border-color: rgba(13, 59, 46, 0.15);
  border-radius: 0.75rem;
  box-shadow: var(--shadow-card);
}
/* Viva's footer is deep brown (StorePal's is navy), so StorePal's navy footer rule is undone here for the parts
   Viva's footer reuses. */
[data-theme='storepal'][data-skin='viva'] footer[data-rg='footer'] {
  background-color: var(--vv-footer);
  color: rgba(255, 255, 255, 0.8);
  --color-ink: #ffffff;
  --color-muted: rgba(255, 255, 255, 0.7);
  --color-line: rgba(255, 255, 255, 0.1);
  --color-line-strong: rgba(255, 255, 255, 0.2);
  --color-surface: rgba(255, 255, 255, 0.06);
  --color-canvas: #082a20;
  --color-accent: #0d3b2e;
  --color-accent-dark: #d9e1b5;
}

