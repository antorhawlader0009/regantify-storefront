/* ---------------------------------------------------------------------------------------------------------------------
   Menaura (2026-11-09): the Menaura menswear template (templete/others-templetes/Fashion/Clothing/menaura) on
   StorePal's features. The store layout (and lib/portalRoot.ts for dialogs) adds data-skin="menaura" next to
   data-theme="storepal". Ink (#2b2420) is the shared accent and button colour, mocha (#7a5c40) the highlight, the page is warm cream, headings are Cormorant Garamond, body is Jost.
   Store > Branding's own colour and fonts still win (inline on the same wrapper).
   Shared StorePal parts that Solevo also draws (product panel, account panel, product sections) read the sv-* classes and
   --sv-* variables, so those are re-pointed to Menaura's look below instead of copying the markup.
   --------------------------------------------------------------------------------------------------------------------- */
[data-theme='storepal'][data-skin='menaura'] {
  --color-ink: #2b2420;
  --color-canvas: #faf6f2;
  --color-surface: #ffffff;
  --color-accent: #2b2420;
  --color-accent-dark: #000000;
  --color-accent-light: #f0e8e0;
  --color-muted: #6a5d54;
  --color-line: rgba(122, 92, 64, 0.15);
  --color-line-strong: rgba(43, 36, 32, 0.2);
  --color-success: #15803d;
  --color-success-bg: #e8f6ee;
  --color-save: #7a5c40;
  --mn-brand: #7a5c40;
  --mn-brand-dark: #5f4630;
  --mn-latte: #e9dacb;
  --mn-mocha: #7a5c40;
  --mn-taupe: #9c7a58;
  --mn-stone: #6a5d54;
  --mn-soft: #f0e8e0;
  --mn-cream: #faf6f2;
  --mn-sand: #f0e8e0;
  --mn-peach: #f0e8e0;
  --mn-card: #f0e8e0;
  --mn-panel: #f5efe8;
  --mn-tan: #e9dacb;
  --mn-blush: #f0e8e0;
  --mn-footer: #2b2420;
  /* Names the shared Solevo/PlayMate parts read (cards, stars, soft boxes, copper highlights). */
  --sv-gold: #7a5c40;
  --sv-gold-dark: #5f4630;
  --sv-sand: #f0e8e0;
  --sv-card: #f0e8e0;
  --sv-panel: #f5efe8;
  --pm-card: #f0e8e0;
  --pm-soft: #f0e8e0;
  --pm-yellow: #7a5c40;
  --pm-yellow-strong: #5f4630;
  --font-display: var(--font-cormorant), var(--font-bangla-store, var(--font-bangla)), Georgia, serif;
  --font-sans: var(--font-jost), var(--font-bangla-store, var(--font-bangla)), ui-sans-serif, system-ui, sans-serif;
  --shadow-card: 0 6px 20px rgba(43, 36, 32, 0.1);
  --shadow-card-hover: 0 12px 28px rgba(43, 36, 32, 0.14);
  --shadow-popover: 0 12px 32px rgba(0, 0, 0, 0.16);
  font-family: var(--font-sans);
}

/* The template's container (max-w-7xl, px-4 sm:px-6 lg:px-8). */
[data-skin='menaura'] .mn-wrap {
  margin-left: auto;
  margin-right: auto;
  width: 100%;
  max-width: 80rem;
  padding-left: 1.25rem;
  padding-right: 1.25rem;
}
@media (min-width: 640px) {
  [data-skin='menaura'] .mn-wrap {
    padding-left: 2rem;
    padding-right: 2rem;
  }
}
@media (min-width: 1024px) {
  [data-skin='menaura'] .mn-wrap {
    padding-left: 2.5rem;
    padding-right: 2.5rem;
  }
}
/* The template's buttons: an ink filled one and a white outline one. */
[data-skin='menaura'] .mn-btn-dark,
[data-skin='menaura'] .mn-btn-outline,
[data-skin='menaura'] .sv-btn-dark,
[data-skin='menaura'] .sv-btn-outline {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  border-radius: 0.375rem;
  padding: 0.75rem 1.5rem;
  font-size: 14px;
  font-weight: 500;
  transition: background-color 0.15s, color 0.15s, border-color 0.15s;
}
[data-skin='menaura'] .mn-btn-dark,
[data-skin='menaura'] .sv-btn-dark {
  background: #2b2420;
  color: #fff;
  box-shadow: 0 6px 20px rgba(43, 36, 32, 0.1);
}
[data-skin='menaura'] .mn-btn-dark:hover,
[data-skin='menaura'] .sv-btn-dark:hover {
  background: #000000;
}
[data-skin='menaura'] .mn-btn-outline,
[data-skin='menaura'] .sv-btn-outline {
  border: 1px solid rgba(43, 36, 32, 0.3);
  background: #ffffff;
  color: #2b2420;
}
[data-skin='menaura'] .mn-btn-outline:hover,
[data-skin='menaura'] .sv-btn-outline:hover {
  background: #f0e8e0;
}
[data-skin='menaura'] .sv-btn-outline.\!border-ink {
  border-color: #2b2420 !important;
}
[data-skin='menaura'] .mn-no-scrollbar {
  scrollbar-width: none;
}
[data-skin='menaura'] .mn-no-scrollbar::-webkit-scrollbar {
  display: none;
}
/* Hero picture fades into the gradient behind it (the template's hero-fade). */
[data-skin='menaura'] .mn-hero-fade {
  -webkit-mask-image: linear-gradient(to bottom, #000 65%, transparent 100%);
  mask-image: linear-gradient(to bottom, #000 65%, transparent 100%);
}
@media (min-width: 768px) {
  [data-skin='menaura'] .mn-hero-fade {
    -webkit-mask-image: linear-gradient(to right, transparent 0%, #000 40%);
    mask-image: linear-gradient(to right, transparent 0%, #000 40%);
  }
}
@keyframes mn-fade-up {
  from {
    opacity: 0;
    transform: translateY(12px);
  }
  to {
    opacity: 1;
    transform: none;
  }
}
@keyframes mn-fade-in {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}
.mn-fade-up {
  animation: mn-fade-up 0.5s ease both;
}
.mn-fade-in {
  animation: mn-fade-in 0.4s ease both;
}
@keyframes mn-marquee-right {
  from {
    transform: translateX(-50%);
  }
  to {
    transform: translateX(0);
  }
}
[data-skin='menaura'] .mn-marquee-track {
  animation: mn-marquee-right 32s linear infinite;
  will-change: transform;
}
[data-skin='menaura'] .mn-marquee:hover .mn-marquee-track,
[data-skin='menaura'] .mn-marquee:focus-within .mn-marquee-track {
  animation-play-state: paused;
}
@media (prefers-reduced-motion: reduce) {
  [data-skin='menaura'] .mn-marquee-track {
    animation: none;
    transform: none;
  }
  [data-skin='menaura'] .mn-marquee {
    overflow-x: auto;
  }
  .mn-fade-up,
  .mn-fade-in {
    animation: none;
  }
}
/* Simple pages (SkinPage): the intro line under the title lines up with it on the left. */
[data-skin='menaura'] .mn-page > p.text-center:first-child {
  margin-top: -1rem;
  text-align: left;
}
/* The account panel (shared with Solevo's markup): rounded inputs, the template's coral main button. */
[data-skin='menaura'] .sv-auth input:not([type='checkbox']):not([type='radio']) {
  border-radius: 0.375rem;
}
[data-skin='menaura'] .sv-auth input:focus {
  border-color: #7a5c40;
  box-shadow: none;
}
[data-skin='menaura'] .sv-auth button[type='submit'] {
  border-radius: 0.375rem;
  background: #2b2420;
  color: #fff;
  font-size: 14px;
  font-weight: 500;
}
[data-skin='menaura'] .sv-auth button[type='submit']:hover {
  background: #000000;
}
/* The product panel's tabs and quantity box take the corner radius of the template's cards. */
[data-skin='menaura'] [data-rg='product-tabs'] .border-accent {
  border-color: #7a5c40;
}
[data-skin='menaura'] [data-rg='product-tabs'] span.rounded-full.bg-accent {
  background-color: #7a5c40;
}
/* Menaura's checkout page: StorePal's form cards become the template's white rounded boxes with the soft shadow. */
[data-skin='menaura'] .mn-checkout div.bg-surface.border-line.rounded-lg {
  background: #fff;
  border-color: rgba(122, 92, 64, 0.15);
  border-radius: 0.75rem;
  box-shadow: var(--shadow-card);
}
/* Menaura's footer is deep brown (StorePal's is navy), so StorePal's navy footer rule is undone here for the parts
   Menaura's footer reuses. */
[data-theme='storepal'][data-skin='menaura'] footer[data-rg='footer'] {
  background-color: var(--mn-footer);
  color: rgba(255, 255, 255, 0.8);
  --color-ink: #ffffff;
  --color-muted: rgba(255, 255, 255, 0.7);
  --color-line: rgba(255, 255, 255, 0.1);
  --color-line-strong: rgba(255, 255, 255, 0.2);
  --color-surface: rgba(255, 255, 255, 0.06);
  --color-canvas: #2b2420;
  --color-accent: #e9dacb;
  --color-accent-dark: #ffffff;
}

