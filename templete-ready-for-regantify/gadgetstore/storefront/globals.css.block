/* ---------------------------------------------------------------------------------------------------------------------
   Gadgetstore: the Gadget Store template (templete/others-templetes/Technology & Gadget/gadget-store) on StorePal's features. The
   store layout (and lib/portalRoot.ts for dialogs) adds data-skin="gadgetstore" next to data-theme="storepal". A clean white
   tech shop: lime (#BAD61F, deeper #a5c015) for filled buttons and tags with dark text, near-black ink (#0a0a0a), a black top bar,
   a light grey hero (#f1f1f1 to #e4e4e4) with the product blended in, flat soft-grey (#f5f5f5) product pictures with a black Add
   to Cart bar, uppercase spaced menu and button labels, a white footer, DM Sans everywhere with a letter-spaced wordmark. Store >
   Branding's own colour and fonts still win. Shared StorePal parts that Solevo also draws read the sv-* classes and --sv-*
   variables, re-pointed to this look below.
   --------------------------------------------------------------------------------------------------------------------- */
[data-theme='storepal'][data-skin='gadgetstore'] {
  --color-ink: #0a0a0a;
  --color-canvas: #ffffff;
  --color-surface: #ffffff;
  --color-accent: #0a0a0a;
  --color-accent-dark: #2a2a2a;
  --color-accent-light: #f5f5f5;
  --color-muted: #525252;
  --color-line: #e5e5e5;
  --color-line-strong: rgba(0, 0, 0, 0.25);
  --color-success: #15803d;
  --color-success-bg: #e8f6ee;
  --color-save: #4d6a00;
  --gs-brand: #BAD61F;
  --gs-brand-dark: #a5c015;
  --gs-lime-text: #5f7a00;
  --gs-latte: #e5e5e5;
  --gs-mocha: #BAD61F;
  --gs-taupe: #BAD61F;
  --gs-stone: #525252;
  --gs-soft: #f5f5f5;
  --gs-cream: #ffffff;
  --gs-sand: #f5f5f5;
  --gs-peach: #f5f5f5;
  --gs-card: #f5f5f5;
  --gs-panel: #f5f5f5;
  --gs-tan: #e5e5e5;
  --gs-blush: #f5f5f5;
  --gs-footer: #ffffff;
  --gs-ink: #0a0a0a;
  --gs-deeper: #000000;
  --gs-sage: #f5f5f5;
  /* Names the shared Solevo/PlayMate parts read (cards, stars, soft boxes, copper highlights). */
  --sv-gold: #BAD61F;
  --sv-gold-dark: #a5c015;
  --sv-sand: #f5f5f5;
  --sv-card: #f5f5f5;
  --sv-panel: #f5f5f5;
  --pm-card: #f5f5f5;
  --pm-soft: #f5f5f5;
  --pm-yellow: #BAD61F;
  --pm-yellow-strong: #a5c015;
  --font-display: var(--font-dm-sans), var(--font-bangla-store, var(--font-bangla)), Georgia, serif;
  --font-sans: var(--font-dm-sans), var(--font-bangla-store, var(--font-bangla)), ui-sans-serif, system-ui, sans-serif;
  --shadow-card: 0 1px 6px rgba(0, 0, 0, 0.06);
  --shadow-card-hover: 0 8px 24px rgba(0, 0, 0, 0.12);
  --shadow-popover: 0 12px 32px rgba(0, 0, 0, 0.16);
  font-family: var(--font-sans);
  font-size: 14px;
}

/* The template's container (max-w-7xl, px-4 sm:px-6 lg:px-8). */
[data-skin='gadgetstore'] .gs-wrap {
  margin-left: auto;
  margin-right: auto;
  width: 100%;
  max-width: 1200px;
  padding-left: 1.5rem;
  padding-right: 1.5rem;
}
@media (min-width: 640px) {
  [data-skin='gadgetstore'] .gs-wrap {
    padding-left: 1.5rem;
    padding-right: 1.5rem;
  }
}
@media (min-width: 1024px) {
  [data-skin='gadgetstore'] .gs-wrap {
    padding-left: 1.5rem;
    padding-right: 1.5rem;
  }
}
/* The template's buttons: a green filled one and a green outline one. */
[data-skin='gadgetstore'] .gs-btn-dark,
[data-skin='gadgetstore'] .gs-btn-outline,
[data-skin='gadgetstore'] .sv-btn-dark,
[data-skin='gadgetstore'] .sv-btn-outline {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  border-radius: 0.375rem;
  padding: 0.7rem 1.5rem;
  font-size: 14px;
  font-weight: 500;
  transition: background-color 0.15s, color 0.15s, border-color 0.15s;
}
[data-skin='gadgetstore'] .gs-btn-dark,
[data-skin='gadgetstore'] .sv-btn-dark {
  background: #BAD61F;
  color: #0a0a0a;
  box-shadow: 0 6px 20px rgba(0, 0, 0, 0.1);
}
[data-skin='gadgetstore'] .gs-btn-dark:hover,
[data-skin='gadgetstore'] .sv-btn-dark:hover {
  background: #a5c015;
}
[data-skin='gadgetstore'] .gs-btn-outline,
[data-skin='gadgetstore'] .sv-btn-outline {
  border: 1px solid #0a0a0a;
  background: transparent;
  color: #0a0a0a;
}
[data-skin='gadgetstore'] .gs-btn-outline:hover,
[data-skin='gadgetstore'] .sv-btn-outline:hover {
  background: #f5f5f5;
}
[data-skin='gadgetstore'] .sv-btn-outline.\!border-ink {
  border-color: #0a0a0a !important;
}
[data-skin='gadgetstore'] .gs-no-scrollbar {
  scrollbar-width: none;
}
[data-skin='gadgetstore'] .gs-no-scrollbar::-webkit-scrollbar {
  display: none;
}
/* Hero picture fades into the gradient behind it (the template's hero-fade). */
[data-skin='gadgetstore'] .gs-hero-fade {
  -webkit-mask-image: linear-gradient(to bottom, #000 65%, transparent 100%);
  mask-image: linear-gradient(to bottom, #000 65%, transparent 100%);
}
@media (min-width: 768px) {
  [data-skin='gadgetstore'] .gs-hero-fade {
    -webkit-mask-image: linear-gradient(to right, transparent 0%, #000 40%);
    mask-image: linear-gradient(to right, transparent 0%, #000 40%);
  }
}
@keyframes gs-fade-up {
  from {
    opacity: 0;
    transform: translateY(12px);
  }
  to {
    opacity: 1;
    transform: none;
  }
}
@keyframes gs-fade-in {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}
.gs-fade-up {
  animation: gs-fade-up 0.5s ease both;
}
.gs-fade-in {
  animation: gs-fade-in 0.4s ease both;
}
@keyframes gs-marquee-right {
  from {
    transform: translateX(-50%);
  }
  to {
    transform: translateX(0);
  }
}
[data-skin='gadgetstore'] .gs-marquee-track {
  animation: gs-marquee-right 32s linear infinite;
  will-change: transform;
}
[data-skin='gadgetstore'] .gs-marquee:hover .gs-marquee-track,
[data-skin='gadgetstore'] .gs-marquee:focus-within .gs-marquee-track {
  animation-play-state: paused;
}
@media (prefers-reduced-motion: reduce) {
  [data-skin='gadgetstore'] .gs-marquee-track {
    animation: none;
    transform: none;
  }
  [data-skin='gadgetstore'] .gs-marquee {
    overflow-x: auto;
  }
  .gs-fade-up,
  .gs-fade-in {
    animation: none;
  }
}
/* Simple pages (SkinPage): the intro line under the title lines up with it on the left. */
[data-skin='gadgetstore'] .gs-page > p.text-center:first-child {
  margin-top: -1rem;
  text-align: left;
}
/* The account panel (shared with Solevo's markup): rounded inputs, the template's coral main button. */
[data-skin='gadgetstore'] .sv-auth input:not([type='checkbox']):not([type='radio']) {
  border-radius: 0.375rem;
}
[data-skin='gadgetstore'] .sv-auth input:focus {
  border-color: #BAD61F;
  box-shadow: none;
}
[data-skin='gadgetstore'] .sv-auth button[type='submit'] {
  border-radius: 0.375rem;
  background: #BAD61F;
  color: #0a0a0a;
  font-size: 14px;
  font-weight: 500;
}
[data-skin='gadgetstore'] .sv-auth button[type='submit']:hover {
  background: #a5c015;
}
/* The product panel's tabs and quantity box take the corner radius of the template's cards. */
[data-skin='gadgetstore'] [data-rg='product-tabs'] .border-accent {
  border-color: #BAD61F;
}
[data-skin='gadgetstore'] [data-rg='product-tabs'] span.rounded-full.bg-accent {
  background-color: #BAD61F;
}
/* Gadgetstore's checkout page: StorePal's form cards become the template's white rounded boxes with the soft shadow. */
[data-skin='gadgetstore'] .gs-checkout div.bg-surface.border-line.rounded-lg {
  background: #fff;
  border-color: rgba(186, 214, 31, 0.15);
  border-radius: 0.75rem;
  box-shadow: var(--shadow-card);
}

/* Gadgetstore's footer is WHITE with ink text: StorePal's base rule paints every footer navy with white text, so re-point it back
   (without this the links are grey-on-navy and unreadable). The call bar inside it uses fixed colours (a black band). */
[data-theme='storepal'][data-skin='gadgetstore'] footer[data-rg='footer'] {
  background-color: var(--gs-footer);
  border-top-color: #e5e5e5;
  color: #404040;
  --color-ink: #0a0a0a;
  --color-muted: #525252;
  --color-line: #e5e5e5;
  --color-line-strong: rgba(0, 0, 0, 0.25);
  --color-surface: #f5f5f5;
  --color-canvas: #ffffff;
  --color-accent: #0a0a0a;
  --color-accent-dark: #2a2a2a;
}
