/* ---------------------------------------------------------------------------------------------------------------------
   Papernest: the PaperNest stationery template (templete/others-templetes/Stationery & Education/papernest) on StorePal's features.
   The store layout (and lib/portalRoot.ts for dialogs) adds data-skin="papernest" next to data-theme="storepal". A bright, playful
   look: a white page, violet (#5B2E9E, hover #4A2487, light #7B4DC0) for buttons, links and the top bar, navy (#1B2A4A) for
   headings and the footer, sun yellow (#FFD54F) and coral (#FF5C7A) for small highlights and tags, a pastel sky-pink-rose hero
   gradient, rounded white cards with a faint violet-blue shadow, Poppins everywhere. Store > Branding's own colour and fonts still
   win. Shared StorePal parts that Solevo also draws read the sv-* classes and --sv-* variables, re-pointed to this look below.
   --------------------------------------------------------------------------------------------------------------------- */
[data-theme='storepal'][data-skin='papernest'] {
  --color-ink: #1e293b;
  --color-canvas: #ffffff;
  --color-surface: #ffffff;
  --color-accent: #5B2E9E;
  --color-accent-dark: #4A2487;
  --color-accent-light: #f5f0fc;
  --color-muted: #525252;
  --color-line: #e2e8f0;
  --color-line-strong: rgba(29, 42, 31, 0.25);
  --color-success: #15803d;
  --color-success-bg: #e8f6ee;
  --color-save: #5B2E9E;
  --pn-brand: #5B2E9E;
  --pn-brand-dark: #4A2487;
  --pn-latte: #f5f0fc;
  --pn-mocha: #5B2E9E;
  --pn-taupe: #5B2E9E;
  --pn-stone: #525252;
  --pn-soft: #f5f0fc;
  --pn-cream: #ffffff;
  --pn-sand: #f5f0fc;
  --pn-peach: #f5f0fc;
  --pn-card: #ffffff;
  --pn-panel: #f5f0fc;
  --pn-tan: #f5f0fc;
  --pn-blush: #f5f0fc;
  --pn-footer: #1B2A4A;
  /* Names the shared Solevo/PlayMate parts read (cards, stars, soft boxes, copper highlights). */
  --sv-gold: #5B2E9E;
  --sv-gold-dark: #4A2487;
  --sv-sand: #f5f0fc;
  --sv-card: #f5f0fc;
  --sv-panel: #f5f0fc;
  --pm-card: #f5f0fc;
  --pm-soft: #f5f0fc;
  --pm-yellow: #5B2E9E;
  --pm-yellow-strong: #4A2487;
  --font-display: var(--font-poppins), var(--font-bangla-store, var(--font-bangla)), Georgia, serif;
  --font-sans: var(--font-poppins), var(--font-bangla-store, var(--font-bangla)), ui-sans-serif, system-ui, sans-serif;
  --shadow-card: 0 2px 10px rgba(30, 30, 80, 0.07);
  --shadow-card-hover: 0 8px 24px rgba(30, 30, 80, 0.14);
  --shadow-popover: 0 12px 32px rgba(0, 0, 0, 0.16);
  font-family: var(--font-sans);
  font-size: 14px;
}

/* The template's container (max-w-7xl, px-4 sm:px-6 lg:px-8). */
[data-skin='papernest'] .pn-wrap {
  margin-left: auto;
  margin-right: auto;
  width: 100%;
  max-width: 1240px;
  padding-left: 1rem;
  padding-right: 1rem;
}
@media (min-width: 640px) {
  [data-skin='papernest'] .pn-wrap {
    padding-left: 1.5rem;
    padding-right: 1.5rem;
  }
}
@media (min-width: 1024px) {
  [data-skin='papernest'] .pn-wrap {
    padding-left: 2rem;
    padding-right: 2rem;
  }
}
/* The template's buttons: an ink filled one and a white outline one. */
[data-skin='papernest'] .pn-btn-dark,
[data-skin='papernest'] .pn-btn-outline,
[data-skin='papernest'] .sv-btn-dark,
[data-skin='papernest'] .sv-btn-outline {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  border-radius: 0.375rem;
  padding: 0.75rem 1.5rem;
  font-size: 14px;
  font-weight: 500;
  transition: background-color 0.15s, color 0.15s, border-color 0.15s;
}
[data-skin='papernest'] .pn-btn-dark,
[data-skin='papernest'] .sv-btn-dark {
  background: #5B2E9E;
  color: #fff;
  box-shadow: 0 6px 20px rgba(29, 42, 31, 0.1);
}
[data-skin='papernest'] .pn-btn-dark:hover,
[data-skin='papernest'] .sv-btn-dark:hover {
  background: #4A2487;
}
[data-skin='papernest'] .pn-btn-outline,
[data-skin='papernest'] .sv-btn-outline {
  border: 1px solid #5B2E9E;
  background: transparent;
  color: #4A2487;
}
[data-skin='papernest'] .pn-btn-outline:hover,
[data-skin='papernest'] .sv-btn-outline:hover {
  background: #f5f0fc;
}
[data-skin='papernest'] .sv-btn-outline.\!border-ink {
  border-color: #5B2E9E !important;
}
[data-skin='papernest'] .pn-no-scrollbar {
  scrollbar-width: none;
}
[data-skin='papernest'] .pn-no-scrollbar::-webkit-scrollbar {
  display: none;
}
/* Hero picture fades into the gradient behind it (the template's hero-fade). */
[data-skin='papernest'] .pn-hero-fade {
  -webkit-mask-image: linear-gradient(to bottom, #000 65%, transparent 100%);
  mask-image: linear-gradient(to bottom, #000 65%, transparent 100%);
}
@media (min-width: 768px) {
  [data-skin='papernest'] .pn-hero-fade {
    -webkit-mask-image: linear-gradient(to right, transparent 0%, #000 40%);
    mask-image: linear-gradient(to right, transparent 0%, #000 40%);
  }
}
@keyframes pn-fade-up {
  from {
    opacity: 0;
    transform: translateY(12px);
  }
  to {
    opacity: 1;
    transform: none;
  }
}
@keyframes pn-fade-in {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}
.pn-fade-up {
  animation: pn-fade-up 0.5s ease both;
}
.pn-fade-in {
  animation: pn-fade-in 0.4s ease both;
}
@keyframes pn-marquee-right {
  from {
    transform: translateX(-50%);
  }
  to {
    transform: translateX(0);
  }
}
[data-skin='papernest'] .pn-marquee-track {
  animation: pn-marquee-right 32s linear infinite;
  will-change: transform;
}
[data-skin='papernest'] .pn-marquee:hover .pn-marquee-track,
[data-skin='papernest'] .pn-marquee:focus-within .pn-marquee-track {
  animation-play-state: paused;
}
@media (prefers-reduced-motion: reduce) {
  [data-skin='papernest'] .pn-marquee-track {
    animation: none;
    transform: none;
  }
  [data-skin='papernest'] .pn-marquee {
    overflow-x: auto;
  }
  .pn-fade-up,
  .pn-fade-in {
    animation: none;
  }
}
/* Simple pages (SkinPage): the intro line under the title lines up with it on the left. */
[data-skin='papernest'] .pn-page > p.text-center:first-child {
  margin-top: -1rem;
  text-align: left;
}
/* The account panel (shared with Solevo's markup): rounded inputs, the template's coral main button. */
[data-skin='papernest'] .sv-auth input:not([type='checkbox']):not([type='radio']) {
  border-radius: 0.375rem;
}
[data-skin='papernest'] .sv-auth input:focus {
  border-color: #5B2E9E;
  box-shadow: none;
}
[data-skin='papernest'] .sv-auth button[type='submit'] {
  border-radius: 0.375rem;
  background: #5B2E9E;
  color: #fff;
  font-size: 14px;
  font-weight: 500;
}
[data-skin='papernest'] .sv-auth button[type='submit']:hover {
  background: #4A2487;
}
/* The product panel's tabs and quantity box take the corner radius of the template's cards. */
[data-skin='papernest'] [data-rg='product-tabs'] .border-accent {
  border-color: #5B2E9E;
}
[data-skin='papernest'] [data-rg='product-tabs'] span.rounded-full.bg-accent {
  background-color: #5B2E9E;
}
/* Papernest's checkout page: StorePal's form cards become the template's white rounded boxes with the soft shadow. */
[data-skin='papernest'] .pn-checkout div.bg-surface.border-line.rounded-lg {
  background: #fff;
  border-color: rgba(30, 30, 80, 0.15);
  border-radius: 0.75rem;
  box-shadow: var(--shadow-card);
}
/* Papernest's footer is deep brown (StorePal's is navy), so StorePal's navy footer rule is undone here for the parts
   Papernest's footer reuses. */
[data-theme='storepal'][data-skin='papernest'] footer[data-rg='footer'] {
  background-color: var(--pn-footer);
  color: rgba(255, 255, 255, 0.8);
  --color-ink: #ffffff;
  --color-muted: rgba(255, 255, 255, 0.7);
  --color-line: rgba(255, 255, 255, 0.1);
  --color-line-strong: rgba(255, 255, 255, 0.2);
  --color-surface: rgba(255, 255, 255, 0.06);
  --color-canvas: #1B2A4A;
  --color-accent: #5B2E9E;
  --color-accent-dark: #d9c7f0;
}

