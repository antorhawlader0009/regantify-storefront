# The NestJS API's origin. This app fetches server-side (SSR/RSC), so
# "localhost" here means THIS machine, not the visitor's browser — set it
# to the actual host running the API.
#
# Local dev on your own machine:
#   API_URL=http://localhost:4000
#
# If your tester team runs this app too (e.g. viewing it from another PC
# on the LAN) point it at your machine's LAN IP instead of localhost:
#   API_URL=http://192.168.1.50:4000
API_URL=http://localhost:4000

# Same API, but reachable from the shopper's own browser (the checkout
# page runs client-side, so it can't use the server-only API_URL above —
# that one only means something on this machine during SSR). Leave unset
# to auto-detect port 4000 on whatever host served the page — same
# pattern as API_URL, just for the browser instead of the server. Only
# set this once the API is reachable at a different host/port than the
# page itself was loaded from:
# NEXT_PUBLIC_API_URL=http://192.168.1.50:4000

# Your real production domain, no protocol/port (e.g. regantify.com).
# Used by middleware.ts to detect a vendor subdomain
# ({subdomain}.regantify.com) and rewrite it internally to /store/:subdomain.
# Leave unset in local dev — subdomain detection is skipped and every
# request falls back to path-based routing (/store/:subdomain), which is
# also what your tester team should keep using over LAN.
ROOT_DOMAIN=

# Shared secret for the backend -> storefront on-demand revalidation call
# (see src/app/api/revalidate/route.ts and the backend's
# server/src/storefront/storefront-revalidate.service.ts). Without this
# set (on BOTH the storefront and the backend, to the same value), the
# backend silently skips calling this endpoint, and the storefront falls
# back to its normal time-based cache window (REVALIDATE_SECONDS in
# storefrontApi.ts) — so a saved product only appears here after that
# window expires, not instantly. Set this to any random long string; it
# just needs to match the backend's REVALIDATE_SECRET.
REVALIDATE_SECRET=

# --- Point this local dev storefront at the real VPS instead of your own
# local server --- uncomment these 3 lines (and comment out/clear
# API_URL and ROOT_DOMAIN above) to run `npm run dev` here while talking
# to the live gadgetdepobd.com backend, with real subdomain routing
# ({subdomain}.gadgetdepobd.com -> /store/:subdomain) instead of
# path-based dev routing. Matches production's own
# ~/regantify/docker-compose.yml build args.
# API_URL=https://api.gadgetdepobd.com
# NEXT_PUBLIC_API_URL=https://api.gadgetdepobd.com
# ROOT_DOMAIN=gadgetdepobd.com

