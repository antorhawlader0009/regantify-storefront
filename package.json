{
  "name": "regantify-storefront",
  "version": "0.1.0",
  "private": true,
  "description": "Regantify — public, server-rendered vendor storefront (Next.js). Renders /store/:subdomain in dev/LAN, and {subdomain}.yourdomain.com in production via middleware rewrite. Talks to the same NestJS API as the vendor dashboard (server/), read-only — no auth.",
  "scripts": {
    "dev": "next dev --turbopack -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint"
  },
  "dependencies": {
    "next": "^15.1.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "nuqs": "^2.4.1",
    "zustand": "^5.0.3",
    "lucide-react": "^0.436.0",
    "jspdf": "^4.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "typescript": "^5.7.2",
    "tailwindcss": "^4.0.0",
    "@tailwindcss/postcss": "^4.0.0",
    "sharp": "^0.35.4"
  },
  "overrides": {
    "postcss": "^8.5.11"
  }
}
